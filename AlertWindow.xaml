<Window x:Class="Glance.AlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Focusable="False" Title="Glance alert"
        FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="{StaticResource Text}" TextOptions.TextFormattingMode="Display"
        Typography.NumeralAlignment="Tabular">
    <!-- A pill like the top bar's, hung under it. The margin leaves room for the shadow. -->
    <Border x:Name="Root" Margin="14,0,14,14" Height="32" CornerRadius="16" BorderBrush="#24FFFFFF" BorderThickness="1"
            Opacity="0" Cursor="Hand" MouseLeftButtonUp="Clicked">
        <Border.RenderTransform>
            <TranslateTransform x:Name="Slide" Y="-10" />
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.45" Color="Black" />
        </Border.Effect>
        <Grid>
            <!-- Countdown along the flat part of the bottom edge: drains left to right, pauses on hover -->
            <Border x:Name="Bar" VerticalAlignment="Bottom" Height="2" Margin="16,0,16,2" CornerRadius="1" RenderTransformOrigin="1,0.5"
                    IsHitTestVisible="False">
                <Border.RenderTransform>
                    <ScaleTransform />
                </Border.RenderTransform>
            </Border>
            <DockPanel Margin="12,0,5,0">
                <Ellipse x:Name="Dot" DockPanel.Dock="Left" Width="7" Height="7" VerticalAlignment="Center" Margin="2,0,10,0" />
                <Border x:Name="ArtBox" DockPanel.Dock="Left" Width="18" Height="18" CornerRadius="5" Margin="0,0,9,0" VerticalAlignment="Center"
                        Visibility="Collapsed">
                    <Border.Background>
                        <ImageBrush x:Name="Art" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
                <Button DockPanel.Dock="Right" Content="&#xE711;" ToolTip="Dismiss" Click="CloseClicked" Cursor="Hand" Focusable="False" Margin="8,0,0,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid Width="20" Height="20" Background="Transparent">
                                <Ellipse x:Name="bg" Fill="White" Opacity="0" />
                                <TextBlock x:Name="glyph" Text="{TemplateBinding Content}" FontFamily="{StaticResource Icons}" FontSize="8"
                                           Foreground="{StaticResource Sub}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Opacity" Value="0.1" />
                                    <Setter TargetName="glyph" Property="Foreground" Value="{StaticResource Text}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="Label" FontSize="11" Foreground="{StaticResource Sub}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="Value" FontSize="12.5" FontWeight="SemiBold" MaxWidth="320" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock x:Name="Unit" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock x:Name="Detail" FontSize="11.5" Foreground="{StaticResource Sub}" Margin="8,0,0,0" MaxWidth="200" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="Side" FontSize="11" Foreground="{StaticResource Sub}" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</Window>
