<Window x:Class="Glance.MiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:g="clr-namespace:Glance"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" SizeToContent="Height"
        Topmost="True" ShowInTaskbar="False" Title="Glance player"
        FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="{StaticResource Text}" TextOptions.TextFormattingMode="Display"
        Typography.NumeralAlignment="Tabular">
    <!-- As wide as the pill above it (set in code); the margin leaves room for the shadow -->
    <Border x:Name="Card" Margin="16,4,16,18" CornerRadius="18" BorderBrush="#24FFFFFF" BorderThickness="1" Padding="14,14,14,10" Opacity="0">
        <Border.RenderTransform>
            <TranslateTransform x:Name="Slide" Y="-8" />
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.5" Color="Black" />
        </Border.Effect>
        <Grid>
            <StackPanel x:Name="Player">
                <DockPanel Cursor="Hand" Background="Transparent" MouseLeftButtonUp="OpenPlayer" ToolTip="Open Now Playing">
                    <Grid DockPanel.Dock="Left" Width="46" Height="46" Margin="0,0,12,0">
                        <Border CornerRadius="8" Background="{StaticResource Track}" />
                        <TextBlock Text="&#xEC4F;" FontFamily="{StaticResource Icons}" FontSize="18" Foreground="{StaticResource Sub}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Border CornerRadius="8">
                            <Border.Background>
                                <ImageBrush x:Name="Cover" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="Song" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="Artist" FontSize="12" Foreground="{StaticResource Sub}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>
                <Slider x:Name="Seek" Margin="0,12,0,0" IsMoveToPointEnabled="True" Focusable="False" ToolTipService.ShowOnDisabled="True"
                        PreviewMouseLeftButtonUp="Seeked" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,2">
                    <Button x:Name="PrevButton" Style="{StaticResource Round}" Width="32" Height="32" FontSize="12" Content="&#xE892;" ToolTip="Previous" Click="Prev" />
                    <Button x:Name="PlayButton" Style="{StaticResource Round}" Width="38" Height="38" FontSize="14" Margin="12,0"
                            Background="{StaticResource Accent}" Foreground="White" Click="Toggle" />
                    <Button x:Name="NextButton" Style="{StaticResource Round}" Width="32" Height="32" FontSize="12" Content="&#xE893;" ToolTip="Next" Click="Next" />
                </StackPanel>
                <g:VolumeBar x:Name="Volume" Margin="0,4,0,0" />
            </StackPanel>
            <TextBlock x:Name="Empty" Text="Nothing is playing" Style="{StaticResource Label}" HorizontalAlignment="Center" Margin="0,2,0,6" />
        </Grid>
    </Border>
</Window>
