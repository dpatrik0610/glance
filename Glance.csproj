<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows SDK version brings the WinRT APIs (media sessions for Now Playing). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Lower idle memory for a long-running tray app; faster startup on publish. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <PublishReadyToRun>true</PublishReadyToRun>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <ApplicationIcon>Glance.ico</ApplicationIcon>
    <Version>1.1.4</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WinForms' "set DPI in code" advice: WPF owns the windows here and reads DPI awareness from the manifest. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same file as the exe icon; window and tray load it from resources. Regenerate: tools\make-icon.ps1 -->
    <Resource Include="Glance.ico" />
    <None Include="Terminal\**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Map\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- Where this build came from, for "Rebuild and restart" (tools\deploy.ps1). Only in local builds: a release
         (-p:PublicBuild=true) carries no path from the machine that built it. -->
    <AssemblyMetadata Include="SourceDir" Value="$(MSBuildProjectDirectory)" Condition="'$(PublicBuild)' != 'true'" />
  </ItemGroup>

  <!-- Sign the exe with the local cert (see tools\trust.ps1). No-op until that cert exists. -->
  <Target Name="SignExe" AfterTargets="Build">
    <!-- Clear PSModulePath: one inherited from PowerShell 7 makes Windows PowerShell load the wrong Security module. -->
    <Exec Command="set &quot;PSModulePath=&quot; &amp; powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\tools\sign.ps1&quot; -Path &quot;$(TargetDir)$(AssemblyName).exe&quot;" />
  </Target>

  <ItemGroup>
    <!-- WinForms is only here for the tray icon; keep its types out of WPF's way. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EasyWindowsTerminalControl" Version="1.0.38" />
    <PackageReference Include="Google.Apis.Calendar.v3" Version="1.78.0.4320" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="MongoDB.Driver" Version="3.13.0" />
  </ItemGroup>

</Project>
