<Window x:Class="Glance.Dialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" Width="468" SizeToContent="Height"
        FontFamily="Bahnschrift, Segoe UI" TextOptions.TextFormattingMode="Display">
    <!-- Same glass as the alert toasts (AlertWindow), without their colored glow; 24px margin leaves room for the shadow -->
    <Grid x:Name="Root" Margin="24" Opacity="0" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="Zoom" ScaleX="0.96" ScaleY="0.96" />
        </Grid.RenderTransform>

        <Border CornerRadius="18" Background="#F20C0C10" MouseLeftButtonDown="Drag">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.45" Color="Black" />
            </Border.Effect>
        </Border>
        <Border CornerRadius="18" BorderThickness="1" IsHitTestVisible="False">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop x:Name="EdgeStop" Offset="0" />
                    <GradientStop Color="#12FFFFFF" Offset="0.5" />
                    <GradientStop Color="#08FFFFFF" Offset="1" />
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.Background>
                <RadialGradientBrush Center="0,0" GradientOrigin="0,0" RadiusX="0.9" RadiusY="1.4">
                    <GradientStop x:Name="WashStop" Offset="0" />
                    <GradientStop Color="#00000000" Offset="1" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <StackPanel Margin="24,20,24,20">
            <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                <Ellipse x:Name="Dot" Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock x:Name="Label" FontSize="11" Foreground="#C8C8CE" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="Headline" FontSize="21" FontWeight="Light" Foreground="White" TextWrapping="Wrap" Margin="0,14,0,0"
                       IsHitTestVisible="False" />
            <TextBlock x:Name="Detail" FontSize="13" Foreground="#9C9CA3" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="19"
                       IsHitTestVisible="False" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" Padding="18,8" Margin="0,0,8,0" Click="Cancel"
                        FontFamily="Segoe UI Variable Text, Segoe UI" Background="#14FFFFFF" />
                <Button x:Name="OkButton" IsDefault="True" Padding="18,8" Click="Ok" Foreground="White" FontWeight="SemiBold"
                        FontFamily="Segoe UI Variable Text, Segoe UI" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
