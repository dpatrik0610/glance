<Window x:Class="Glance.Dialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Glance"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" Width="468" SizeToContent="Height"
        FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="{StaticResource Text}" TextOptions.TextFormattingMode="Display">
    <!-- Opens as the Glance mark on a small dark disc; the disc grows into the card (Shell), the mark flies into the
         header (MarkSlot) and the text rises in. 24px margin leaves room for the shadow. -->
    <Grid x:Name="Root" Margin="24" RenderTransformOrigin="0.5,0.5" MouseLeftButtonDown="Drag">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="Zoom" />
        </Grid.RenderTransform>

        <!-- Glance's window panel, as a card. Width/Height/Radius animate, so it's a Rectangle, not a Border. -->
        <Rectangle x:Name="Shell" Fill="#F5161618" Stroke="{StaticResource Line}" RadiusX="20" RadiusY="20"
                   HorizontalAlignment="Center" VerticalAlignment="Center">
            <Rectangle.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.5" Color="Black" />
            </Rectangle.Effect>
        </Rectangle>
        <!-- The action's colour: a glow from the top left and a lit edge -->
        <Rectangle x:Name="Wash" RadiusX="20" RadiusY="20" IsHitTestVisible="False">
            <Rectangle.Stroke>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop x:Name="EdgeStop" Offset="0" />
                    <GradientStop Color="#00FFFFFF" Offset="0.55" />
                </LinearGradientBrush>
            </Rectangle.Stroke>
            <Rectangle.Fill>
                <RadialGradientBrush Center="0,0" GradientOrigin="0,0" RadiusX="0.9" RadiusY="1.4">
                    <GradientStop x:Name="WashStop" Offset="0" />
                    <GradientStop Color="#00000000" Offset="1" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <StackPanel x:Name="Body" Margin="24,20,24,20">
            <StackPanel.RenderTransform>
                <TranslateTransform x:Name="BodyShift" />
            </StackPanel.RenderTransform>
            <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                <Border x:Name="MarkSlot" Width="22" Height="22" Margin="0,0,9,0" VerticalAlignment="Center" />
                <TextBlock x:Name="Label" Style="{StaticResource Label}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="Headline" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,14,0,0" IsHitTestVisible="False" />
            <TextBlock x:Name="Detail" FontSize="13" Foreground="{StaticResource Sub}" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="19"
                       IsHitTestVisible="False" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" Padding="18,8" Margin="0,0,8,0" Click="Cancel" />
                <Button x:Name="OkButton" Style="{StaticResource Primary}" IsDefault="True" Padding="18,8" FontWeight="SemiBold" Click="Ok" />
            </StackPanel>
        </StackPanel>

        <local:Logo x:Name="Mark" Width="52" Height="52" HorizontalAlignment="Center" VerticalAlignment="Center"
                    RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
            <local:Logo.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="MarkScale" />
                    <TranslateTransform x:Name="MarkShift" />
                </TransformGroup>
            </local:Logo.RenderTransform>
        </local:Logo>
    </Grid>
</Window>
