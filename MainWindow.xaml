<Window x:Class="Glance.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Glance" Icon="Glance.ico" Width="1180" Height="760" MinWidth="820" MinHeight="560"
        WindowStyle="None" Background="Transparent" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="{StaticResource Text}"
        TextOptions.TextFormattingMode="Display">
    <!-- Not a layered window (no AllowsTransparency): glass frame over the whole client, so Windows 11 rounds,
         shadows and borders it natively, and native child windows can render. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="-1" ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Border x:Name="Panel" Background="#C8161618">
        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <!-- Top bar: drag area -->
            <Grid Grid.ColumnSpan="2" Background="Transparent" MouseLeftButtonDown="Drag" Margin="0,0,6,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Ghost}" Width="44" Content="&#xE700;" FontFamily="{StaticResource Icons}"
                            ToolTip="Collapse sidebar" Click="ToggleNav" />
                    <Ellipse Width="14" Height="14" Stroke="{StaticResource Accent}" StrokeThickness="3" Margin="8,0,8,0" />
                    <TextBlock Text="Glance" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="/" Style="{StaticResource Label}" FontSize="16" VerticalAlignment="Center" Margin="10,0" />
                    <TextBlock x:Name="PageTitle" Style="{StaticResource Label}" FontSize="16" VerticalAlignment="Center" />
                </StackPanel>
                <Button Style="{StaticResource Ghost}" HorizontalAlignment="Right" Content="✕" FontSize="13"
                        ToolTip="Hide to tray (Esc)" Click="HideClick" />
            </Grid>

            <!-- Sidebar: grouped tabs (scroll when they don't fit), Settings pinned below as an icon -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ListBox x:Name="Nav" Style="{StaticResource Sidebar}" SelectionChanged="NavChanged">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <!-- Group name when expanded, a thin divider when collapsed to icons -->
                                <DataTemplate>
                                    <Grid Margin="12,10,12,4">
                                        <TextBlock x:Name="Title" Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Sub}" />
                                        <Border x:Name="Divider" Height="1" Background="{StaticResource Line}" Visibility="Collapsed" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="False">
                                            <Setter TargetName="Title" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="Divider" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" ToolTip="{Binding Name}">
                                <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource Icons}" FontSize="16" Width="20"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                <TextBlock Text="{Binding Name}" Margin="12,0,0,0" FontSize="13.5"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                           Visibility="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource Vis}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <ListBox x:Name="Bottom" Grid.Row="1" Style="{StaticResource Sidebar}" HorizontalAlignment="Left" Margin="0,8,0,0"
                         SelectionChanged="NavChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Icon}" ToolTip="{Binding Name}" FontFamily="{StaticResource Icons}" FontSize="16" Width="20"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <ContentControl x:Name="Page" Grid.Row="1" Grid.Column="1" Margin="8,0,0,0" Focusable="False" />
        </Grid>
    </Border>
</Window>
