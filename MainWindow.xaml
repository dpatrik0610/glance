<Window x:Class="Glance.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Glance" Icon="Glance.ico" Width="1180" Height="760" MinWidth="820" MinHeight="560"
        WindowStyle="None" Background="Transparent" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="{StaticResource Text}"
        TextOptions.TextFormattingMode="Display">
    <!-- Not a layered window (no AllowsTransparency): glass frame over the whole client, so Windows 11 rounds,
         shadows and borders it natively, and native child windows can render. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="-1" ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Border x:Name="Panel" Background="#C8161618">
      <Grid>
        <Grid x:Name="Body" Margin="14">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="BodyShift" />
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <!-- Drag area: the top bar's row out to the window's edges (the body's margin and the gap under the bar too) -->
            <Border Grid.ColumnSpan="2" Background="Transparent" MouseLeftButtonDown="Drag" Margin="-14,-14,-14,0" />
            <!-- Top bar -->
            <Grid Grid.ColumnSpan="2" Background="Transparent" MouseLeftButtonDown="Drag" Margin="0,0,6,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="NavToggle" Style="{StaticResource Ghost}" Width="44" Content="&#xE700;" FontFamily="{StaticResource Icons}"
                            ToolTip="Collapse sidebar" Click="ToggleNav" />
                    <Ellipse Width="14" Height="14" Stroke="{StaticResource Accent}" StrokeThickness="3" Margin="8,0,8,0" />
                    <StackPanel x:Name="Brand" Orientation="Horizontal">
                        <TextBlock Text="Glance" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="/" Style="{StaticResource Label}" FontSize="16" VerticalAlignment="Center" Margin="10,0" />
                        <TextBlock x:Name="PageTitle" Style="{StaticResource Label}" FontSize="16" VerticalAlignment="Center" />
                    </StackPanel>
                    <!-- Compact mode: the tabs as a row of icons instead of the sidebar -->
                    <ListBox x:Name="Strip" Style="{StaticResource Sidebar}" Visibility="Collapsed" Margin="2,0,0,0" SelectionChanged="StripChanged">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Icon}" ToolTip="{Binding Name}" FontFamily="{StaticResource Icons}" FontSize="15" Margin="-3,-3"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="PinButton" Style="{StaticResource Ghost}" FontFamily="{StaticResource Icons}" FontSize="13" Margin="0,0,4,0"
                            Content="&#xE718;" Click="PinClick" />
                    <Button x:Name="CompactButton" Style="{StaticResource Ghost}" FontFamily="{StaticResource Icons}" FontSize="13" Margin="0,0,4,0"
                            Content="&#xE73F;" ToolTip="Compact mode"
                            Click="CompactClick" />
                    <Button Style="{StaticResource Ghost}" Content="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="13" Margin="0,0,4,0"
                            ToolTip="Search everything (Ctrl+K)" Click="PaletteClick" />
                    <Button Style="{StaticResource Ghost}" Content="✕" FontSize="13" ToolTip="Hide to tray (Esc)" Click="HideClick" />
                </StackPanel>
            </Grid>

            <!-- Sidebar: grouped tabs (scroll when they don't fit), Settings pinned below as an icon -->
            <Grid x:Name="Side" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ListBox x:Name="Nav" Style="{StaticResource Sidebar}" SelectionChanged="NavChanged">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <!-- Group name when expanded, a thin divider when collapsed to icons -->
                                <DataTemplate>
                                    <Grid Margin="12,10,12,4">
                                        <TextBlock x:Name="Title" Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Sub}" />
                                        <Border x:Name="Divider" Height="1" Background="{StaticResource Line}" Visibility="Collapsed" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="False">
                                            <Setter TargetName="Title" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="Divider" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" ToolTip="{Binding Name}">
                                <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource Icons}" FontSize="16" Width="20"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                <TextBlock Text="{Binding Name}" Margin="12,0,0,0" FontSize="13.5"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                           Visibility="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource Vis}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <ListBox x:Name="Bottom" Grid.Row="1" Style="{StaticResource Sidebar}" HorizontalAlignment="Left" Margin="0,8,0,0"
                         SelectionChanged="NavChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Icon}" ToolTip="{Binding Name}" FontFamily="{StaticResource Icons}" FontSize="16" Width="20"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <ContentControl x:Name="Page" Grid.Row="1" Grid.Column="1" Margin="8,0,0,0" Focusable="False">
                <ContentControl.RenderTransform>
                    <TranslateTransform x:Name="PageShift" />
                </ContentControl.RenderTransform>
            </ContentControl>
        </Grid>

        <!-- Ctrl+K command palette: one search over pages, actions, repos, containers, notes and clipboard -->
        <Grid x:Name="PaletteLayer" Visibility="Collapsed" Background="#8C000000" MouseLeftButtonDown="PaletteBackdrop">
            <Border x:Name="PaletteCard" Width="640" VerticalAlignment="Top" Margin="16,84,16,16" CornerRadius="20" Padding="10"
                    Background="#F51A1A1E" BorderBrush="{StaticResource Line}" BorderThickness="1" RenderTransformOrigin="0.5,0">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="PaletteZoom" />
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.6" />
                </Border.Effect>
                <DockPanel>
                    <!-- The TextBox applies its Padding twice (border + text host), so the box look lives on this Border instead -->
                    <Border DockPanel.Dock="Top" CornerRadius="14" Background="{StaticResource Track}" Padding="16,0,8,0">
                        <DockPanel>
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="15" Foreground="{StaticResource Accent}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox x:Name="Query" FontSize="16" Padding="2,11" Background="Transparent" BorderThickness="0"
                                     Tag="Search pages, repos, containers, notes, clipboard…" TextChanged="QueryChanged" PreviewKeyDown="QueryKey" />
                        </DockPanel>
                    </Border>
                    <DockPanel DockPanel.Dock="Bottom" Margin="8,8,8,2">
                        <TextBlock DockPanel.Dock="Right" Text="↑↓  ·  Enter  ·  Esc" Style="{StaticResource Label}" FontSize="11.5" Opacity="0.7" />
                        <TextBlock x:Name="PaletteStatus" Style="{StaticResource Label}" FontSize="11.5" Foreground="{StaticResource Accent}" />
                    </DockPanel>
                    <ListBox x:Name="Results" Style="{StaticResource Sidebar}" MaxHeight="430" Margin="0,8,0,0"
                             PreviewMouseLeftButtonUp="ResultClicked">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource Icons}" FontSize="15" Width="28" VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Kind}" FontSize="12" Opacity="0.65" Margin="12,0,0,0" VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                    <TextBlock Text="{Binding Title}" FontSize="13.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
      </Grid>
    </Border>
</Window>
