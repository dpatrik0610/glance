<UserControl x:Class="Glance.Pages.MediaPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True" Drop="Dropped" DragOver="DraggedOver">
    <DockPanel>
        <!-- Settings: trim, resize, output -->
        <Border DockPanel.Dock="Right" Style="{StaticResource Card}" Width="300">
            <StackPanel x:Name="Controls" IsEnabled="False">
                <TextBlock Text="Trim" Style="{StaticResource H}" Margin="0,0,0,10" />
                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="Start" Width="44" VerticalAlignment="Center" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="At playhead" Click="StartHere" />
                    <TextBox x:Name="StartBox" Margin="0,0,8,0" KeyDown="TimeKey" LostFocus="TimeCommit" ToolTip="m:ss.f, or seconds" />
                </DockPanel>
                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="End" Width="44" VerticalAlignment="Center" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="At playhead" Click="EndHere" />
                    <TextBox x:Name="EndBox" Margin="0,0,8,0" KeyDown="TimeKey" LostFocus="TimeCommit" ToolTip="m:ss.f, or seconds" />
                </DockPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Reset" Click="ResetTrim" />
                    <TextBlock x:Name="TrimText" Style="{StaticResource Label}" VerticalAlignment="Center" />
                </DockPanel>

                <StackPanel x:Name="ResizePanel">
                    <TextBlock Text="Resize" Style="{StaticResource H}" Margin="0,18,0,10" />
                    <WrapPanel x:Name="Sizes" />
                    <TextBlock x:Name="ResizeText" Style="{StaticResource Label}" />
                </StackPanel>

                <TextBlock Text="Save as" Style="{StaticResource H}" Margin="0,18,0,10" />
                <WrapPanel x:Name="FormatChips" Margin="0,0,0,2" />
                <TextBlock x:Name="FormatText" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,0,0,6" />
                <StackPanel x:Name="QualityRow">
                    <TextBlock Text="Quality" Margin="0,4,0,6" />
                    <WrapPanel x:Name="Qualities" />
                </StackPanel>
                <TextBlock x:Name="SizeText" Style="{StaticResource Label}" Margin="0,10,0,0" TextWrapping="Wrap" />
                <Button x:Name="SaveButton" Style="{StaticResource Primary}" Content="Save as…" Margin="0,14,0,0" Click="Save" />
                <DockPanel x:Name="Working" Margin="0,14,0,0" Visibility="Collapsed">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Cancel" Click="CancelClick" Margin="8,0,0,0" />
                    <ProgressBar x:Name="Bar" Maximum="100" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock x:Name="Status" Style="{StaticResource Label}" Margin="0,10,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- The file, playable, to find where to cut -->
        <Border Style="{StaticResource Card}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Button DockPanel.Dock="Right" Content="Open…" Click="OpenClick" />
                    <TextBlock x:Name="FileText" Style="{StaticResource Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Text="Open a video or audio file or drop one here: MP4, MOV, MKV, AVI, WMV, MP3, M4A, WAV, FLAC, WMA." />
                </DockPanel>
                <DockPanel x:Name="Player" DockPanel.Dock="Bottom" Margin="0,10,0,0" IsEnabled="False">
                    <Button x:Name="PlayButton" DockPanel.Dock="Left" Style="{StaticResource Ghost}" FontFamily="{StaticResource Icons}" Content="&#xE768;"
                            Click="PlayClick" ToolTip="Play / pause" Margin="0,0,10,0" />
                    <TextBlock x:Name="TimeText" DockPanel.Dock="Right" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="10,0,0,0" />
                    <Slider x:Name="Seek" ValueChanged="Seeked" />
                </DockPanel>
                <Grid>
                    <MediaElement x:Name="Preview" LoadedBehavior="Manual" UnloadedBehavior="Manual" ScrubbingEnabled="True" Stretch="Uniform"
                                  MediaOpened="PreviewOpened" MediaEnded="PreviewEnded" MediaFailed="PreviewFailed" />
                    <TextBlock x:Name="DropHint" Text="&#xE714;" FontFamily="{StaticResource Icons}" FontSize="48" Foreground="{StaticResource Sub}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                </Grid>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
