<UserControl x:Class="Glance.Pages.DevPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Content="↻ Refresh" Click="Refresh" />
                <TextBox x:Name="Filter" DockPanel.Dock="Right" Width="200" Margin="0,0,10,0" TextChanged="FilterChanged"
                         ToolTip="Filter by port or process" />
                <TextBlock Text="Listening ports" Style="{StaticResource H}" VerticalAlignment="Center" />
            </DockPanel>
            <Grid DockPanel.Dock="Top" Margin="0,0,10,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="70" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Port" Style="{StaticResource Label}" />
                <TextBlock Grid.Column="1" Text="Process" Style="{StaticResource Label}" />
                <TextBlock Grid.Column="2" Text="PID" Style="{StaticResource Label}" />
                <TextBlock Grid.Column="3" Text="Address" Style="{StaticResource Label}" />
            </Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="Ports">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2,10,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource Ghost}" HorizontalAlignment="Left" Padding="0,2" Click="OpenPort"
                                        ToolTip="Open http://localhost:port">
                                    <TextBlock Text="{Binding Port}" Foreground="{StaticResource Accent}" FontFamily="Cascadia Mono, Consolas" />
                                </Button>
                                <TextBlock Grid.Column="1" Text="{Binding Process}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{Binding Pid}" Style="{StaticResource Label}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding Address}" Style="{StaticResource Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="4" Style="{StaticResource Ghost}" Content="Kill" Foreground="{StaticResource Red}"
                                        HorizontalAlignment="Right" Click="Kill" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
