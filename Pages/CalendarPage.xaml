<UserControl x:Class="Glance.Pages.CalendarPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <!-- Month, navigation, sync state -->
        <DockPanel DockPanel.Dock="Top" Margin="6,0,6,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="RefreshButton" Style="{StaticResource Ghost}" Content="&#xE72C;" FontFamily="{StaticResource Icons}" ToolTip="Sync now"
                        Click="RefreshClick" Margin="0,0,4,0" />
                <Button x:Name="DisconnectButton" Style="{StaticResource Ghost}" Content="Disconnect" Click="DisconnectClick"
                        ToolTip="Forget the Google sign-in on this PC" />
            </StackPanel>
            <Button Style="{StaticResource Ghost}" Content="&#xE76B;" FontFamily="{StaticResource Icons}" Click="PrevClick" ToolTip="Previous month" />
            <Button Style="{StaticResource Ghost}" Content="&#xE76C;" FontFamily="{StaticResource Icons}" Click="NextClick" ToolTip="Next month"
                    Margin="2,0,10,0" />
            <TextBlock x:Name="MonthText" Style="{StaticResource H}" FontSize="18" VerticalAlignment="Center" />
            <Button Content="Today" Margin="14,0,0,0" Click="TodayClick" />
            <TextBlock x:Name="Status" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="14,0,0,0" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <!-- The selected day -->
        <Border DockPanel.Dock="Right" Style="{StaticResource Card}" Width="300">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Button x:Name="AddButton" DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="+ Event" Click="AddClick" />
                    <StackPanel>
                        <TextBlock x:Name="DayText" Style="{StaticResource H}" />
                        <TextBlock x:Name="DaySub" Style="{StaticResource Label}" Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="Agenda" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid>
            <Border Style="{StaticResource Card}" Padding="10">
                <Grid x:Name="Month" />
            </Border>

            <!-- Not connected: how to, over the month (which still shows Glance's own due items) -->
            <Border x:Name="ConnectCard" Style="{StaticResource Card}" Background="#F2161618" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Width="470" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Connect Google Calendar" Style="{StaticResource H}" FontSize="17" Margin="0,0,0,8" />
                    <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap" LineHeight="19" Margin="0,0,0,12">
                        One-time setup with your own Google client, so nothing goes through anyone else:<LineBreak />
                        1. In console.cloud.google.com, make a project and enable the Google Calendar API.<LineBreak />
                        2. OAuth consent screen: External, add yourself as a test user, then publish it ("In production").
                        In "Testing", Google ends the sign-in every 7 days.<LineBreak />
                        3. Credentials → Create OAuth client ID → Desktop app. Paste its ID and secret here.
                    </TextBlock>
                    <TextBox x:Name="ClientIdBox" Tag="Client ID (…apps.googleusercontent.com)" Margin="0,0,0,8" />
                    <TextBox x:Name="ClientSecretBox" Tag="Client secret" Margin="0,0,0,12" />
                    <DockPanel>
                        <Button x:Name="ConnectButton" DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="Connect" Click="ConnectClick" />
                        <TextBlock x:Name="ConnectStatus" Style="{StaticResource Label}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"
                                   Text="Your browser opens for Google's consent page." />
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
