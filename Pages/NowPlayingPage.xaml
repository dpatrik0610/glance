<UserControl x:Class="Glance.Pages.NowPlayingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:g="clr-namespace:Glance">

    <Grid>
        <Border x:Name="Card" Style="{StaticResource Card}" VerticalAlignment="Top" Padding="22" Visibility="Collapsed">
            <DockPanel>
                <!-- Cover; the note shows through when there's none -->
                <Grid DockPanel.Dock="Left" Width="210" Height="210" Margin="0,0,28,0" VerticalAlignment="Top">
                    <Border CornerRadius="14" Background="{StaticResource Track}" />
                    <TextBlock Text="&#xEC4F;" FontFamily="{StaticResource Icons}" FontSize="52" Foreground="{StaticResource Sub}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Border CornerRadius="14">
                        <Border.Background>
                            <ImageBrush x:Name="Cover" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                </Grid>

                <StackPanel VerticalAlignment="Center">
                    <!-- One chip per player; the switch when there are several -->
                    <WrapPanel x:Name="Sources" Margin="0,0,0,14" />
                    <TextBlock x:Name="TitleText" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="ArtistText" FontSize="15" Foreground="{StaticResource Sub}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="AlbumText" Style="{StaticResource Label}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />

                    <StackPanel x:Name="Timeline" Margin="0,22,0,0">
                        <Slider x:Name="Seek" IsMoveToPointEnabled="True" ToolTipService.ShowOnDisabled="True"
                                PreviewMouseLeftButtonUp="Seeked" />
                        <DockPanel Margin="0,6,0,0">
                            <TextBlock x:Name="Total" DockPanel.Dock="Right" Style="{StaticResource Label}" FontSize="11.5" />
                            <TextBlock x:Name="Elapsed" Style="{StaticResource Label}" FontSize="11.5" />
                        </DockPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                        <Button x:Name="PrevButton" Style="{StaticResource Round}" Content="&#xE892;" ToolTip="Previous" Click="Prev" />
                        <Button x:Name="PlayButton" Style="{StaticResource Round}" Width="52" Height="52" Margin="16,0" FontSize="18"
                                Background="{StaticResource Accent}" Foreground="White" Click="Toggle" />
                        <Button x:Name="NextButton" Style="{StaticResource Round}" Content="&#xE893;" ToolTip="Next" Click="Next" />
                    </StackPanel>
                    <g:VolumeBar x:Name="Volume" Width="240" HorizontalAlignment="Center" Margin="0,12,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <StackPanel x:Name="Empty" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="&#xEC4F;" FontFamily="{StaticResource Icons}" FontSize="40" Foreground="{StaticResource Sub}" HorizontalAlignment="Center" />
            <TextBlock Text="Nothing is playing" Style="{StaticResource H}" HorizontalAlignment="Center" Margin="0,14,0,4" />
            <TextBlock Text="Spotify, YouTube, SoundCloud and other players show up here." Style="{StaticResource Label}" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
