<UserControl x:Class="Glance.Pages.NetworkPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:g="clr-namespace:Glance">
    <UserControl.Resources>
        <!-- Click-to-copy value (Tag = text to copy) -->
        <Style x:Key="Copyable" TargetType="Button" BasedOn="{StaticResource Ghost}">
            <Setter Property="Padding" Value="0,1" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="ToolTip" Value="Click to copy" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <!-- Public IP, throughput, latency -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*" />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Padding="6,2" Content="&#xE72C;" FontFamily="{StaticResource Icons}"
                                FontSize="12" Foreground="{StaticResource Sub}" ToolTip="Look up again" Click="RefreshIp" />
                        <TextBlock Text="Public IP" Style="{StaticResource Label}" VerticalAlignment="Center" />
                    </DockPanel>
                    <Button Style="{StaticResource Copyable}" Margin="0,4,0,0" Click="CopyIp">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="IpText" Text="…" Style="{StaticResource Big}" FontSize="26" FontFamily="{StaticResource Mono}" />
                            <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource Icons}" FontSize="15" Foreground="{StaticResource Accent}"
                                       VerticalAlignment="Center" Margin="12,2,0,0" />
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="IpWhere" Style="{StaticResource Label}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Download" Style="{StaticResource Label}" />
                    <TextBlock x:Name="DownRate" Text="—" Style="{StaticResource Big}" FontSize="26" Margin="0,4,0,0" />
                    <TextBlock x:Name="DownTotal" Style="{StaticResource Label}" />
                    <g:Spark x:Name="DownSpark" Format="rate" Color="#5AA9FF" Max="0" Height="30" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Upload" Style="{StaticResource Label}" />
                    <TextBlock x:Name="UpRate" Text="—" Style="{StaticResource Big}" FontSize="26" Margin="0,4,0,0" />
                    <TextBlock x:Name="UpTotal" Style="{StaticResource Label}" />
                    <g:Spark x:Name="UpSpark" Format="rate" Color="#B07CFF" Max="0" Height="30" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Latency · 1.1.1.1" Style="{StaticResource Label}" />
                    <TextBlock x:Name="PingText" Text="—" Style="{StaticResource Big}" FontSize="26" Margin="0,4,0,0" />
                    <TextBlock x:Name="PingSub" Style="{StaticResource Label}" TextTrimming="CharacterEllipsis" ToolTip="Router ping · jitter · packet loss, last minute" />
                    <g:Spark x:Name="PingSpark" Format="{}{0:0} ms" Color="#4CC37A" Max="0" Height="30" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.9*" />
                <ColumnDefinition Width="1.3*" />
                <ColumnDefinition Width="1.2*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Adapters" Style="{StaticResource H}" Margin="0,0,0,10" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="Adapters">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,8,16">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Label}" TextTrimming="CharacterEllipsis" Margin="0,0,0,6" />
                                        <ItemsControl ItemsSource="{Binding Fields}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="64" />
                                                            <ColumnDefinition />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Label}" Margin="0,2,0,0" />
                                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Values}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Button Style="{StaticResource Copyable}" Tag="{Binding}" Click="CopyTag">
                                                                        <TextBlock Text="{Binding}" FontFamily="{StaticResource Mono}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Speed test: the dial, results under it -->
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <TextBlock x:Name="SpeedNote" DockPanel.Dock="Right" Style="{StaticResource Label}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxWidth="220" Margin="10,1,0,0" />
                        <TextBlock Text="Speed test" Style="{StaticResource H}" VerticalAlignment="Center" />
                    </DockPanel>
                    <UniformGrid DockPanel.Dock="Bottom" Columns="3" Margin="-3,10,-3,0">
                        <Border Background="#0CFFFFFF" CornerRadius="12" Padding="12,9" Margin="3,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Label}" FontSize="11.5"><Run Text="◷" Foreground="#4CC37A" /> Ping</TextBlock>
                                <TextBlock Margin="0,2,0,0"><Run x:Name="SpeedPing" Text="—" FontSize="20" FontWeight="SemiBold" /><Run Text=" ms" Foreground="{StaticResource Sub}" FontSize="11.5" /></TextBlock>
                                <TextBlock x:Name="SpeedJitter" Style="{StaticResource Label}" FontSize="11.5" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="#0CFFFFFF" CornerRadius="12" Padding="12,9" Margin="3,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Label}" FontSize="11.5"><Run Text="↓" Foreground="#5AA9FF" /> Download</TextBlock>
                                <TextBlock Margin="0,2,0,0"><Run x:Name="SpeedDown" Text="—" FontSize="20" FontWeight="SemiBold" /><Run Text=" Mbps" Foreground="{StaticResource Sub}" FontSize="11.5" /></TextBlock>
                                <g:Spark x:Name="DownTrace" Format="{}{0:0.#} Mbps" Color="#5AA9FF" Max="0" Height="22" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="#0CFFFFFF" CornerRadius="12" Padding="12,9" Margin="3,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Label}" FontSize="11.5"><Run Text="↑" Foreground="#B07CFF" /> Upload</TextBlock>
                                <TextBlock Margin="0,2,0,0"><Run x:Name="SpeedUp" Text="—" FontSize="20" FontWeight="SemiBold" /><Run Text=" Mbps" Foreground="{StaticResource Sub}" FontSize="11.5" /></TextBlock>
                                <g:Spark x:Name="UpTrace" Format="{}{0:0.#} Mbps" Color="#B07CFF" Max="0" Height="22" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <g:SpeedGauge Margin="0,8,0,0" />
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBox x:Name="Filter" DockPanel.Dock="Right" Width="140" Tag="Filter" VerticalAlignment="Center" TextChanged="FilterChanged" />
                        <TextBlock Text="Connections" Style="{StaticResource H}" VerticalAlignment="Center" />
                        <TextBlock x:Name="ConnCount" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="10,1,0,0" />
                    </DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,10,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Process" Style="{StaticResource Label}" />
                        <TextBlock Grid.Column="1" Text="Remote" Style="{StaticResource Label}" />
                        <TextBlock Grid.Column="2" Text="Port" Style="{StaticResource Label}" HorizontalAlignment="Right" />
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="Conns">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,10,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="3*" />
                                            <ColumnDefinition Width="60" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Process}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Pid}" />
                                        <Button Grid.Column="1" Style="{StaticResource Copyable}" Tag="{Binding Remote}" Click="CopyTag">
                                            <TextBlock Text="{Binding Remote}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{StaticResource Sub}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Button>
                                        <TextBlock Grid.Column="2" Text="{Binding Port}" Style="{StaticResource Label}" HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" FontFamily="{StaticResource Mono}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- "Copied" toast -->
        <Border x:Name="Toast" Grid.RowSpan="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,20"
                Background="{StaticResource Accent}" CornerRadius="14" Padding="14,6" Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock x:Name="ToastText" Foreground="White" FontWeight="SemiBold" />
        </Border>
    </Grid>
</UserControl>
