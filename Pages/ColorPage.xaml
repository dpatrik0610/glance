<UserControl x:Class="Glance.Pages.ColorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <!-- Picker: saturation/brightness square, hue strip, the color, recent picks -->
                <Border Style="{StaticResource Card}">
                    <StackPanel Width="280">
                        <Grid x:Name="Sv" Height="190" Cursor="Cross" Background="Transparent"
                              MouseLeftButtonDown="SvDown" MouseMove="SvMove" MouseLeftButtonUp="DragEnd">
                            <Grid.Clip>
                                <RectangleGeometry x:Name="SvClip" RadiusX="10" RadiusY="10" />
                            </Grid.Clip>
                            <Rectangle x:Name="HueFill" />
                            <Rectangle>
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="White" Offset="0" />
                                        <GradientStop Color="#00FFFFFF" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle>
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#00000000" Offset="0" />
                                        <GradientStop Color="Black" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Canvas IsHitTestVisible="False">
                                <Ellipse x:Name="SvThumb" Width="16" Height="16" Stroke="White" StrokeThickness="2.5" />
                            </Canvas>
                        </Grid>
                        <Grid x:Name="HueBar" Height="16" Margin="0,12,0,0" Cursor="Hand" Background="Transparent"
                              MouseLeftButtonDown="HueDown" MouseMove="HueMove" MouseLeftButtonUp="DragEnd">
                            <Border CornerRadius="8">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FF0000" Offset="0" />
                                        <GradientStop Color="#FFFF00" Offset="0.1667" />
                                        <GradientStop Color="#00FF00" Offset="0.3333" />
                                        <GradientStop Color="#00FFFF" Offset="0.5" />
                                        <GradientStop Color="#0000FF" Offset="0.6667" />
                                        <GradientStop Color="#FF00FF" Offset="0.8333" />
                                        <GradientStop Color="#FF0000" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Canvas IsHitTestVisible="False">
                                <Ellipse x:Name="HueThumb" Width="18" Height="18" Canvas.Top="-1" Stroke="White" StrokeThickness="2.5" />
                            </Canvas>
                        </Grid>

                        <DockPanel Margin="0,16,0,0">
                            <Border x:Name="Swatch" Width="52" Height="52" CornerRadius="12" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                    Margin="0,0,12,0" />
                            <StackPanel VerticalAlignment="Center">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" FontFamily="{StaticResource Icons}" Content="&#xE8C8;"
                                            Margin="6,0,0,0" ToolTip="Copy hex" Click="CopyHex" />
                                    <TextBox x:Name="HexBox" FontFamily="{StaticResource Mono}" FontSize="15" KeyDown="HexKey" LostFocus="HexCommit"
                                             ToolTip="Hex (#ff6a3d, #f60) or RGB (255 106 61). Enter applies." />
                                </DockPanel>
                                <Button Content="Pick from screen" Margin="0,8,0,0" Click="PickClick" ToolTip="Click anywhere on screen; Esc cancels" />
                            </StackPanel>
                        </DockPanel>

                        <TextBlock x:Name="RecentLabel" Text="Recent" Style="{StaticResource Label}" Margin="0,16,0,6" />
                        <WrapPanel x:Name="Recent" />
                    </StackPanel>
                </Border>

                <!-- Values and contrast -->
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock x:Name="Status" DockPanel.Dock="Right" Style="{StaticResource Label}" VerticalAlignment="Center" />
                            <TextBlock Text="Values" Style="{StaticResource H}" />
                        </DockPanel>
                        <ItemsControl x:Name="Values">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Row" CornerRadius="8" Padding="10,7" Margin="0,0,0,2" Background="Transparent" Cursor="Hand"
                                            MouseLeftButtonUp="CopyValue" ToolTip="Click to copy">
                                        <DockPanel>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Label}" Width="64" />
                                            <TextBlock Text="{Binding Value}" FontFamily="{StaticResource Mono}" FontSize="13" />
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{StaticResource Track}" />
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Contrast as text (WCAG)" Style="{StaticResource H}" Margin="0,16,0,10" />
                        <UniformGrid x:Name="Contrast" Columns="2" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Color theory: palettes built from the current color -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Label}" VerticalAlignment="Center"
                                   Text="Click a swatch to copy · double-click to start from it" />
                        <TextBlock Text="Palettes" Style="{StaticResource H}" />
                    </DockPanel>
                    <StackPanel x:Name="Palettes" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
