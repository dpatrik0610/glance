<UserControl x:Class="Glance.Pages.StocksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:g="clr-namespace:Glance">
    <DockPanel>
        <!-- Add a symbol: Enter or the button -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="Add" Margin="8,0,0,0" Click="Add" />
                    <TextBox x:Name="SymbolBox" Tag="Symbol: AAPL, MSFT, OTP.BD, ^GSPC" KeyDown="SymbolKey" />
                </DockPanel>
                <TextBlock x:Name="Hint" Style="{StaticResource Label}" Foreground="{StaticResource Amber}" Margin="0,8,0,0" Visibility="Collapsed" />
                <TextBlock Style="{StaticResource Label}" FontSize="11" Margin="0,8,0,0"
                           Text="Yahoo Finance, delayed · Budapest symbols end in .BD, indexes start with ^" />
            </StackPanel>
        </Border>

        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="Cards">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" VerticalAlignment="Top" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Box" Style="{StaticResource Card}">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top">
                                        <Button x:Name="Remove" DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="✕" FontSize="11" ToolTip="Remove"
                                                Opacity="0" Margin="4,-4,-8,0" VerticalAlignment="Top" Click="RemoveCard" />
                                        <Border DockPanel.Dock="Right" Style="{StaticResource Pill}" Background="{StaticResource Track}" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Change}" Foreground="{Binding Brush}" FontSize="12" />
                                        </Border>
                                        <TextBlock Text="{Binding Symbol}" FontWeight="SemiBold" FontSize="15" />
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Label}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="{Binding Price}" Style="{StaticResource Big}" FontSize="24" Margin="0,6,0,8"
                                               Typography.NumeralAlignment="Tabular" />
                                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Range}" Style="{StaticResource Label}" FontSize="11" Margin="0,6,0,0" />
                                    <g:Spark Series="{Binding Closes}" Format="{Binding Format}" Color="#E6A65D" Max="0" MinHeight="40" />
                                </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="Box" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Remove" Property="Opacity" Value="1" />
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <g:Logo Width="44" Height="44" Margin="0,0,0,12" Status="{Binding Text, ElementName=Status}" />
                <TextBlock x:Name="Status" Style="{StaticResource Label}" FontSize="14" HorizontalAlignment="Center" TextAlignment="Center" />
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
