<UserControl x:Class="Glance.Pages.SystemPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:g="clr-namespace:Glance">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1.1*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Stat tiles -->
        <UniformGrid Columns="4">
            <Border x:Name="CpuTile" Style="{StaticResource Card}" Cursor="Hand" ToolTip="Open in History" Tag="CPU load" MouseLeftButtonUp="OpenHistory">
                <StackPanel>
                    <DockPanel>
                        <Border x:Name="CpuTempPill" Style="{StaticResource Pill}" DockPanel.Dock="Right" Tag="CPU temperature" ToolTip="Temperature history" MouseLeftButtonUp="OpenHistory">
                            <TextBlock x:Name="CpuTemp" FontSize="12" FontWeight="SemiBold" />
                        </Border>
                        <TextBlock Text="CPU" Style="{StaticResource Label}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock x:Name="CpuLoad" Style="{StaticResource Big}" Margin="0,6,0,0" />
                    <TextBlock x:Name="CpuSub" Style="{StaticResource Label}" />
                    <g:Spark x:Name="CpuSpark" Format="{}{0:0}%" Color="#E6A65D" Height="34" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
            <Border x:Name="GpuTile" Style="{StaticResource Card}" Cursor="Hand" ToolTip="Open in History" Tag="GPU load" MouseLeftButtonUp="OpenHistory">
                <StackPanel>
                    <DockPanel>
                        <Border x:Name="GpuTempPill" Style="{StaticResource Pill}" DockPanel.Dock="Right" Tag="GPU temperature" ToolTip="Temperature history" MouseLeftButtonUp="OpenHistory">
                            <TextBlock x:Name="GpuTemp" FontSize="12" FontWeight="SemiBold" />
                        </Border>
                        <TextBlock Text="GPU" Style="{StaticResource Label}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock x:Name="GpuLoad" Style="{StaticResource Big}" Margin="0,6,0,0" />
                    <TextBlock x:Name="GpuSub" Style="{StaticResource Label}" />
                    <g:Spark x:Name="GpuSpark" Format="{}{0:0}%" Color="#4CC37A" Height="34" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Cursor="Hand" ToolTip="Open in History" Tag="Memory" MouseLeftButtonUp="OpenHistory">
                <StackPanel>
                    <DockPanel>
                        <TextBlock x:Name="RamPct" DockPanel.Dock="Right" Style="{StaticResource Label}" />
                        <TextBlock Text="Memory" Style="{StaticResource Label}" />
                    </DockPanel>
                    <TextBlock x:Name="RamUsed" Style="{StaticResource Big}" Margin="0,6,0,0" />
                    <TextBlock x:Name="RamSub" Style="{StaticResource Label}" />
                    <g:Spark x:Name="RamSpark" Format="{}{0:0}%" Color="#F5B83D" Height="34" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Cursor="Hand" ToolTip="Open in History" Tag="Download" MouseLeftButtonUp="OpenHistory">
                <StackPanel>
                    <TextBlock Text="Network" Style="{StaticResource Label}" />
                    <TextBlock x:Name="NetDown" Style="{StaticResource Big}" Margin="0,6,0,0" />
                    <TextBlock x:Name="NetUp" Style="{StaticResource Label}" />
                    <Grid Height="34" Margin="0,10,0,0">
                        <g:Spark x:Name="DownSpark" Format="rate" Color="#5AA9FF" Max="0" />
                        <g:Spark x:Name="UpSpark" Format="rate" Color="#B07CFF" Max="0" />
                    </Grid>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Load history + drives -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Cursor="Hand" ToolTip="Open in History" Tag="CPU load" MouseLeftButtonUp="OpenHistory">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource Accent}" Margin="0,0,6,0" />
                            <TextBlock Text="CPU" Style="{StaticResource Label}" Margin="0,0,14,0" />
                            <Ellipse Width="8" Height="8" Fill="{StaticResource Green}" Margin="0,0,6,0" />
                            <TextBlock Text="GPU" Style="{StaticResource Label}" />
                        </StackPanel>
                        <TextBlock Text="Load · last 60 samples" Style="{StaticResource H}" />
                    </DockPanel>
                    <Grid>
                        <!-- 25% gridlines -->
                        <UniformGrid Rows="4">
                            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" />
                            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" />
                            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" />
                            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,1" />
                        </UniformGrid>
                        <g:Spark x:Name="CpuHistory" Format="{}{0:0}%" Color="#E6A65D" />
                        <g:Spark x:Name="GpuHistory" Format="{}{0:0}%" Color="#4CC37A" />
                    </Grid>
                </DockPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Drives" Style="{StaticResource H}" Margin="0,0,0,12" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="Drives">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,14">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Text}" Style="{StaticResource Label}" />
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        </DockPanel>
                                        <ProgressBar Value="{Binding Pct, Mode=OneWay}" Margin="0,6,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Processes + system info -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="34" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Top processes" Style="{StaticResource H}" />
                        <!-- Click a column to sort by it -->
                        <TextBlock x:Name="ByCpu" Grid.Column="1" Tag="CPU" Text="CPU ↓" Style="{StaticResource Label}" HorizontalAlignment="Right"
                                   Cursor="Hand" Background="Transparent" Foreground="{StaticResource Text}" MouseLeftButtonUp="SortBy" />
                        <TextBlock x:Name="ByGpu" Grid.Column="2" Tag="GPU" Text="GPU" Style="{StaticResource Label}" HorizontalAlignment="Right"
                                   Cursor="Hand" Background="Transparent" MouseLeftButtonUp="SortBy" />
                        <TextBlock x:Name="ByMem" Grid.Column="3" Tag="Memory" Text="Memory" Style="{StaticResource Label}" HorizontalAlignment="Right"
                                   Cursor="Hand" Background="Transparent" MouseLeftButtonUp="SortBy" />
                    </Grid>
                    <!-- Holds still while the mouse is over it, so the end button stays put -->
                    <ItemsControl x:Name="Procs">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid x:Name="Row" Background="Transparent" MinHeight="24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="34" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="Count" Text="{Binding Count, StringFormat='  ×{0}'}" Style="{StaticResource Label}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding CpuText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding GpuText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding MemText}" Style="{StaticResource Label}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <Button x:Name="End" Grid.Column="4" Style="{StaticResource Ghost}" Content="&#xE711;" FontFamily="{StaticResource Icons}"
                                            FontSize="10" Padding="6,3" HorizontalAlignment="Right" Foreground="{StaticResource Red}" Opacity="0"
                                            ToolTip="End process" Click="EndProcess"
                                            Visibility="{Binding CanKill, Converter={StaticResource Vis}}" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Count}" Value="1">
                                        <Setter TargetName="Count" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="End" Property="Opacity" Value="1" />
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
            <!-- The heaviest process per resource, whatever the table is sorted by -->
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock x:Name="Uptime" DockPanel.Dock="Right" Style="{StaticResource Label}" VerticalAlignment="Center" ToolTip="Time since Windows started" />
                        <TextBlock Text="Top consumers" Style="{StaticResource H}" />
                    </DockPanel>
                    <ItemsControl x:Name="Busiest">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock Text="{Binding What}" Style="{StaticResource Label}" Width="64" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Value}" DockPanel.Dock="Right" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="{Binding Name}" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
