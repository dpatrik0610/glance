<UserControl x:Class="Glance.Pages.AnalysisPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:g="clr-namespace:Glance">
    <UserControl.Resources>
        <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="KpiValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,4,0,2" />
        </Style>
        <Style x:Key="KpiCell" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
            <Setter Property="Padding" Value="20,14" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style x:Key="LegendDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Margin" Value="14,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <!-- Fills the window; scrolls only once it's shorter than the dashboard needs -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid MinHeight="640" Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Verdict: how the PC is doing over the range, and why -->
            <DockPanel Margin="8,2,6,10">
                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                    <StackPanel x:Name="RangeChips" Orientation="Horizontal" HorizontalAlignment="Right" />
                    <TextBlock x:Name="Status" Style="{StaticResource Caption}" HorizontalAlignment="Right" Margin="0,6,6,0" />
                </StackPanel>
                <Border x:Name="VerdictBadge" Width="44" Height="44" CornerRadius="14" Background="{StaticResource PillBg}" VerticalAlignment="Center">
                    <TextBlock x:Name="VerdictIcon" FontFamily="{StaticResource Icons}" FontSize="20" Text="&#xE9D9;"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Sub}" />
                </Border>
                <StackPanel Margin="14,0,16,0" VerticalAlignment="Center">
                    <TextBlock x:Name="VerdictTitle" Text="Analyzing…" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="VerdictSub" Style="{StaticResource Label}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- KPI strip: one surface, divided -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource KpiCell}" BorderThickness="0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Style="{StaticResource LegendDot}" Fill="#E6A65D" Margin="0,0,8,0" />
                                <TextBlock Text="CPU load · average" Style="{StaticResource Caption}" />
                            </StackPanel>
                            <TextBlock x:Name="CpuAvg" Text="—" Style="{StaticResource KpiValue}" />
                            <TextBlock x:Name="CpuSub" Style="{StaticResource Caption}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource KpiCell}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Style="{StaticResource LegendDot}" Fill="#B07CFF" Margin="0,0,8,0" />
                                <TextBlock Text="Memory · average" Style="{StaticResource Caption}" />
                            </StackPanel>
                            <TextBlock x:Name="MemAvg" Text="—" Style="{StaticResource KpiValue}" />
                            <TextBlock x:Name="MemSub" Style="{StaticResource Caption}" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="StrainCell" Grid.Column="2" Style="{StaticResource KpiCell}">
                        <StackPanel>
                            <TextBlock Text="Under strain" Style="{StaticResource Caption}" />
                            <TextBlock x:Name="StrainValue" Text="—" Style="{StaticResource KpiValue}" />
                            <TextBlock x:Name="StrainSub" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource KpiCell}">
                        <StackPanel>
                            <TextBlock Text="Windows reports" Style="{StaticResource Caption}" />
                            <TextBlock x:Name="IssuesValue" Text="—" Style="{StaticResource KpiValue}" />
                            <TextBlock x:Name="IssuesSub" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.8*" />
                    <ColumnDefinition Width="*" MinWidth="280" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Load over time, with Windows' events on a lane underneath -->
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="110" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,12">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Style="{StaticResource LegendDot}" Fill="#E6A65D" />
                                <TextBlock Text="CPU" Style="{StaticResource Caption}" />
                                <Ellipse Style="{StaticResource LegendDot}" Fill="#B07CFF" />
                                <TextBlock Text="Memory" Style="{StaticResource Caption}" />
                                <Line X2="16" Margin="14,0,6,0" Stroke="{StaticResource Red}" StrokeThickness="1" StrokeDashArray="3 2" VerticalAlignment="Center" />
                                <TextBlock Text="Strain limit" Style="{StaticResource Caption}" />
                            </StackPanel>
                            <TextBlock Text="Load over time" Style="{StaticResource H}" />
                        </DockPanel>
                        <!-- 0–100% scale: the dashed line sits at the 85% CPU strain limit -->
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="15*" />
                                <RowDefinition Height="35*" />
                                <RowDefinition Height="50*" />
                            </Grid.RowDefinitions>
                            <Border Grid.RowSpan="3" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" />
                            <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" />
                            <TextBlock Grid.Row="2" Text="50%" Style="{StaticResource Caption}" FontSize="10.5" Margin="0,2,0,0" />
                            <Line Grid.Row="1" X2="1" Stretch="Fill" VerticalAlignment="Top" Stroke="{StaticResource Red}" StrokeThickness="1"
                                  StrokeDashArray="3 3" Opacity="0.7" />
                            <g:Spark x:Name="CpuChart" Grid.RowSpan="3" Color="#E6A65D" Max="100" Format="CPU {0:0}%" />
                            <g:Spark x:Name="MemChart" Grid.RowSpan="3" Color="#B07CFF" Max="100" Format="Memory {0:0}%" />
                            <TextBlock x:Name="ChartNone" Grid.RowSpan="3" Style="{StaticResource Label}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Visibility="Collapsed" Text="No history yet: one sample is logged per minute." />
                        </Grid>
                        <!-- Event lane: dots where Windows logged trouble -->
                        <Canvas x:Name="Events" Grid.Row="2" Height="14" Margin="0,8,0,0" ClipToBounds="True" Background="Transparent" />
                        <DockPanel Grid.Row="3" Margin="0,4,0,0">
                            <TextBlock DockPanel.Dock="Right" Text="now" Style="{StaticResource Caption}" FontSize="11" />
                            <TextBlock x:Name="ChartFrom" Style="{StaticResource Caption}" FontSize="11" />
                            <TextBlock Text="● Windows events" Style="{StaticResource Caption}" FontSize="11" HorizontalAlignment="Center" />
                        </DockPanel>
                    </Grid>
                </Border>

                <!-- Ranked consumers of one resource over the range -->
                <Border Grid.Row="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <StackPanel x:Name="KindChips" DockPanel.Dock="Right" Orientation="Horizontal" />
                            <TextBlock Text="Top consumers" Style="{StaticResource H}" VerticalAlignment="Center" />
                        </DockPanel>
                        <Grid Margin="8,0,8,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="#" Style="{StaticResource Caption}" />
                            <TextBlock Grid.Column="1" Text="App" Style="{StaticResource Caption}" />
                            <TextBlock Grid.Column="3" Text="Average" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="4" Text="Peak" Style="{StaticResource Caption}" HorizontalAlignment="Right" ToolTip="Its busiest minute" />
                            <TextBlock Grid.Column="5" Text="Active" Style="{StaticResource Caption}" HorizontalAlignment="Right"
                                       ToolTip="How long it was among the 5 heaviest apps" />
                        </Grid>
                        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,0,0,4" />
                        <TextBlock x:Name="ConsumersNone" Text="Nothing logged in this range." Style="{StaticResource Label}" Margin="8,6" Visibility="Collapsed" />
                        <ItemsControl x:Name="Consumers">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Row" CornerRadius="8" Padding="8,0" Background="Transparent">
                                        <Grid Height="30">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26" />
                                                <ColumnDefinition Width="1.2*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="70" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Rank}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                       ToolTip="{Binding Name}" Margin="0,0,12,0" />
                                            <!-- Share bar: this app against the heaviest one -->
                                            <Grid Grid.Column="2" Height="6" VerticalAlignment="Center">
                                                <Border Background="{StaticResource Track}" CornerRadius="3" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="{Binding Fill}" />
                                                        <ColumnDefinition Width="{Binding Rest}" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Background="{Binding Color}" CornerRadius="3" />
                                                </Grid>
                                            </Grid>
                                            <TextBlock Grid.Column="3" Text="{Binding Avg}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="4" Text="{Binding Peak}" Style="{StaticResource Label}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="5" Text="{Binding Active}" Style="{StaticResource Label}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="#0DFFFFFF" />
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- What Windows logged: crashes, freezes, disk and driver trouble -->
                <Border Grid.Column="1" Grid.RowSpan="2" Style="{StaticResource Card}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock Text="Windows reports" Style="{StaticResource H}" />
                            <TextBlock Text="From the event logs · hover for details" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" />
                        <TextBlock x:Name="ReportsNone" DockPanel.Dock="Top" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="Reports">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,10" Background="Transparent"
                                                ToolTip="{Binding Message}" ToolTipService.ShowDuration="60000">
                                            <DockPanel>
                                                <Border x:Name="Bar" Width="3" CornerRadius="1.5" Background="{StaticResource Amber}" Margin="0,2,12,2" />
                                                <StackPanel DockPanel.Dock="Right" Margin="12,0,0,0">
                                                    <Border x:Name="CountPill" Style="{StaticResource Pill}" Padding="7,1" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding CountText}" FontSize="11.5" FontWeight="SemiBold" />
                                                    </Border>
                                                    <TextBlock Text="{Binding LastText}" Style="{StaticResource Caption}" FontSize="11" HorizontalAlignment="Right" Margin="0,4,0,0" />
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Serious}" Value="True">
                                                <Setter TargetName="Bar" Property="Background" Value="{StaticResource Red}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Count}" Value="1">
                                                <Setter TargetName="CountPill" Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
