<UserControl x:Class="Glance.Pages.ExchangePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:g="clr-namespace:Glance">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ItemsControl x:Name="Cards">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="2" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top">
                                <Border DockPanel.Dock="Right" Style="{StaticResource Pill}" Background="{StaticResource Track}">
                                    <TextBlock Text="{Binding Change}" FontSize="12" />
                                </Border>
                                <TextBlock Text="{Binding Code}" FontWeight="SemiBold" FontSize="15" />
                                <TextBlock Text="{Binding Name}" Style="{StaticResource Label}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{Binding Value}" Style="{StaticResource Big}" Margin="0,6,0,8" />
                            <TextBlock DockPanel.Dock="Bottom" Text="{Binding Range}" Style="{StaticResource Label}" FontSize="11" Margin="0,6,0,0" />
                            <g:Spark Series="{Binding Series}" Format="{Binding SparkFormat}" Color="#E6A65D" Max="0" MinHeight="40" />
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Converter -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock x:Name="Source" DockPanel.Dock="Bottom" Style="{StaticResource Label}" FontSize="11" Margin="0,10,0,0" />
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBox x:Name="Amount" Width="140" FontSize="16" Text="100" TextChanged="Recalc" />
                    <TextBlock x:Name="FromCode" FontSize="16" Margin="10,0" VerticalAlignment="Center" />
                    <Button Style="{StaticResource Ghost}" Content="&#xE8AB;" FontFamily="{StaticResource Icons}" ToolTip="Swap direction" Click="Swap" />
                    <TextBlock x:Name="Result" FontSize="22" FontWeight="SemiBold" Margin="14,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <Border Style="{StaticResource Segment}" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel x:Name="CurrencyChips" Orientation="Horizontal" />
                </Border>
            </DockPanel>
        </Border>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <g:Logo Width="44" Height="44" Margin="0,0,0,12" Status="{Binding Text, ElementName=Status}" />
            <TextBlock x:Name="Status" Style="{StaticResource Label}" FontSize="14" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
