<UserControl x:Class="Glance.Pages.ClipboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
        <DockPanel>
            <!-- Title row bar (IHeader): search, the recording switches, clear -->
            <StackPanel x:Name="Bar" DockPanel.Dock="Top" Orientation="Horizontal">
                <TextBox x:Name="Search" Width="200" Tag="Search clipboard" TextChanged="SearchChanged" />
                <CheckBox x:Name="RecordBox" Style="{StaticResource Switch}" Content="Record  " Margin="14,0,0,0"
                          VerticalAlignment="Center" Click="RecordToggled" />
                <CheckBox x:Name="ImagesBox" Style="{StaticResource Switch}" Content="Images  " Margin="10,0,0,0"
                          VerticalAlignment="Center" Click="RecordToggled" ToolTip="Also keep copied images (the newest 20)" />
                <Button Style="{StaticResource Ghost}" Content="Clear all" Margin="6,0,0,0" Click="ClearAll" />
            </StackPanel>
            <TextBlock x:Name="Status" DockPanel.Dock="Top" Style="{StaticResource Label}" Margin="12,4,0,8"
                       Text="Click an entry to copy it. Kept in memory only." />
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="List">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Row" CornerRadius="10" Padding="12,8" Margin="0,0,8,2" Background="Transparent"
                                    Cursor="Hand" MouseLeftButtonUp="CopyItem">
                                <DockPanel>
                                    <StackPanel x:Name="Actions" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Opacity="0">
                                        <Button Style="{StaticResource Ghost}" Content="Open" FontSize="11"
                                                ToolTip="Open in the image viewer" Click="OpenItem"
                                                Visibility="{Binding IsImage, Converter={StaticResource Vis}}" />
                                        <Button Style="{StaticResource Ghost}" Content="✕" FontSize="11" ToolTip="Remove" Click="RemoveItem" />
                                    </StackPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding When}" Style="{StaticResource Label}" FontSize="11"
                                               VerticalAlignment="Top" Margin="10,4,6,0" />
                                    <Grid>
                                        <TextBlock x:Name="Body" Text="{Binding Preview}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="58"
                                                   FontFamily="{StaticResource Mono}" FontSize="12.5" />
                                        <!-- Images: a fixed-size preview, then the size -->
                                        <StackPanel x:Name="Picture" Orientation="Horizontal" Visibility="Collapsed">
                                            <Border Width="160" Height="100" CornerRadius="8" Background="{StaticResource Track}">
                                                <Border.Clip>
                                                    <RectangleGeometry Rect="0,0,160,100" RadiusX="8" RadiusY="8" />
                                                </Border.Clip>
                                                <Image Source="{Binding Thumb}" Stretch="UniformToFill" />
                                            </Border>
                                            <TextBlock Text="{Binding Text}" Style="{StaticResource Label}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsImage}" Value="True">
                                    <Setter TargetName="Body" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="Picture" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="{StaticResource CardBg}" />
                                    <Setter TargetName="Actions" Property="Opacity" Value="1" />
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
</UserControl>
