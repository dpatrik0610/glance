<UserControl x:Class="Glance.Pages.ClipboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Content="Clear all" Margin="10,0,0,0" Click="ClearAll" />
                <CheckBox x:Name="ImagesBox" DockPanel.Dock="Right" Style="{StaticResource Switch}" Content="Images  " Margin="10,0,0,0"
                          VerticalAlignment="Center" Click="RecordToggled" ToolTip="Also keep copied images (the newest 20)" />
                <CheckBox x:Name="RecordBox" DockPanel.Dock="Right" Style="{StaticResource Switch}" Content="Record  " Margin="10,0,0,0"
                          VerticalAlignment="Center" Click="RecordToggled" />
                <TextBox x:Name="Search" DockPanel.Dock="Right" Width="220" TextChanged="SearchChanged" ToolTip="Search" />
                <TextBlock x:Name="Status" Style="{StaticResource Label}" VerticalAlignment="Center"
                           Text="Click an entry to copy it. Kept in memory only." />
            </DockPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="List">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Row" CornerRadius="12" Padding="14,10" Margin="0,0,8,6" Background="{StaticResource CardBg}"
                                    Cursor="Hand" MouseLeftButtonUp="CopyItem">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="✕" FontSize="11"
                                            VerticalAlignment="Top" ToolTip="Remove" Click="RemoveItem" />
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Open" FontSize="11" VerticalAlignment="Top"
                                            ToolTip="Open in the image viewer" Click="OpenItem"
                                            Visibility="{Binding IsImage, Converter={StaticResource Vis}}" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding When}" Style="{StaticResource Label}" FontSize="11"
                                               VerticalAlignment="Top" Margin="10,4,6,0" />
                                    <Grid>
                                        <TextBlock x:Name="Body" Text="{Binding Preview}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="58"
                                                   FontFamily="{StaticResource Mono}" FontSize="12.5" />
                                        <!-- Images: a fixed-size preview, then the size -->
                                        <StackPanel x:Name="Picture" Orientation="Horizontal" Visibility="Collapsed">
                                            <Border Width="160" Height="100" CornerRadius="8" Background="{StaticResource Track}">
                                                <Border.Clip>
                                                    <RectangleGeometry Rect="0,0,160,100" RadiusX="8" RadiusY="8" />
                                                </Border.Clip>
                                                <Image Source="{Binding Thumb}" Stretch="UniformToFill" />
                                            </Border>
                                            <TextBlock Text="{Binding Text}" Style="{StaticResource Label}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsImage}" Value="True">
                                    <Setter TargetName="Body" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="Picture" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="{StaticResource Track}" />
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
