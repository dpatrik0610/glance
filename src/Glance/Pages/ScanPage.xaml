<UserControl x:Class="Glance.Pages.ScanPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:g="clr-namespace:Glance">
    <DockPanel>
        <!-- What to scan: a drive chip or a folder -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
            <StackPanel>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                        <Button Content="Folder…" Margin="0,0,6,0" Click="PickFolder" />
                        <Button x:Name="FastButton" Content="Fast scan" Margin="0,0,6,0" Click="FastScan"
                                ToolTip="WinDirStat as administrator: it reads the drive's file table instead of walking every folder" />
                        <Button x:Name="ScanButton" Style="{StaticResource Primary}" Content="Scan" MinWidth="80" Click="Scan" />
                    </StackPanel>
                    <!-- Wraps to a second line rather than cutting a drive off -->
                    <Border Style="{StaticResource Segment}">
                        <WrapPanel x:Name="Drives" />
                    </Border>
                </DockPanel>
                <TextBlock x:Name="Summary" Style="{StaticResource Label}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                <!-- What the folder shown is made of, by file type -->
                <StackPanel x:Name="KindPanel" Visibility="Collapsed" Margin="0,10,0,0">
                    <Grid x:Name="KindBar" Height="8" RenderTransformOrigin="0,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="KindGrow" />
                        </Grid.RenderTransform>
                    </Grid>
                    <ItemsControl x:Name="KindLegend" Margin="0,8,0,0" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,2,16,2">
                                    <Ellipse Width="8" Height="8" Fill="{Binding Brush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource Sub}" FontSize="12" />
                                    <TextBlock Text="{Binding Size}" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid>
            <Grid x:Name="Result" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*" MaxWidth="380" />
                    <ColumnDefinition Width="8*" />
                </Grid.ColumnDefinitions>

                <!-- The folder shown, biggest item first: click a folder to go in -->
                <Border Style="{StaticResource Card}" Padding="8">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="2,0,6,6">
                            <Button x:Name="UpButton" DockPanel.Dock="Left" Style="{StaticResource Ghost}" FontFamily="{StaticResource Icons}" Content="&#xE74A;"
                                    ToolTip="Up one folder" AutomationProperties.Name="Up one folder" Click="Up" />
                            <TextBlock x:Name="PathText" VerticalAlignment="Center" Margin="6,0,0,0" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="List" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Row" CornerRadius="8" Padding="10,6" Background="Transparent" MouseLeftButtonUp="RowClick">
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Show in Explorer" Click="RowReveal" />
                                                    <MenuItem Header="Move to Recycle Bin" Click="RowRecycle" />
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Icon}" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Sub}"
                                                               VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Size}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                               Margin="10,0,0,0" Typography.NumeralAlignment="Tabular" />
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                </DockPanel>
                                                <!-- Its size next to the biggest item's -->
                                                <Border Height="3" CornerRadius="1.5" Background="{StaticResource Track}" Margin="0,5,0,0">
                                                    <Border CornerRadius="1.5" Background="{StaticResource Accent}" RenderTransformOrigin="0,0.5">
                                                        <Border.RenderTransform>
                                                            <ScaleTransform ScaleX="{Binding Share}" />
                                                        </Border.RenderTransform>
                                                    </Border>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{StaticResource Track}" />
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- The same folder as areas: click a block to go into that folder -->
                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="10">
                    <DockPanel>
                        <TextBlock x:Name="HoverText" DockPanel.Dock="Bottom" Style="{StaticResource Label}" FontSize="11.5" Margin="2,8,0,0"
                                   TextTrimming="CharacterEllipsis" />
                        <g:Treemap x:Name="Map" ClipToBounds="True" ContextMenuOpening="MapMenuOpening">
                            <g:Treemap.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Show in Explorer" Click="MapReveal" />
                                    <MenuItem Header="Move to Recycle Bin" Click="MapRecycle" />
                                </ContextMenu>
                            </g:Treemap.ContextMenu>
                        </g:Treemap>
                    </DockPanel>
                </Border>
            </Grid>

            <StackPanel x:Name="Idle" HorizontalAlignment="Center" VerticalAlignment="Center">
                <g:DiskRing x:Name="Ring" Width="210" Height="210" Margin="0,0,0,14" />
                <TextBlock x:Name="Status" Style="{StaticResource Label}" FontSize="14" HorizontalAlignment="Center" TextAlignment="Center" />
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
