<UserControl x:Class="Glance.Pages.CliPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Glance.Pages"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <UserControl.Resources>
        <!-- Tab chip: tinted with its color when selected -->
        <Style x:Key="TabChip" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Sub}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Margin="0,0,4,0" Height="34">
                            <Border x:Name="hov" CornerRadius="9" Background="{StaticResource CardBg}" Opacity="0" />
                            <Border x:Name="b" CornerRadius="9" Padding="12,0,4,0" BorderThickness="1"
                                    Background="Transparent" BorderBrush="Transparent">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hov" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource In}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hov" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Out}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{Binding Tint}" />
                                <Setter TargetName="b" Property="BorderBrush" Value="{Binding Brush}" />
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- Tab strip: the tabs in one row (the wheel scrolls it), then + for a new shell (right-click it for more); split and quick folders sit at the far right, by the pin.
             Moved into the window's title row (IHeader) when the page is built. -->
        <DockPanel x:Name="Bar" DockPanel.Dock="Top">
            <!-- Split, folders, then a divider before the window's pin -->
            <Border DockPanel.Dock="Right" Width="1" Height="18" Margin="10,0,2,0" Background="{StaticResource Line}" />
            <ToggleButton x:Name="FoldersToggle" DockPanel.Dock="Right" Style="{StaticResource IconToggle}" Width="34" Height="34" Padding="0"
                          Margin="2,0,0,0" Content="&#xE8B7;" FontFamily="{StaticResource Icons}" FontSize="14"
                          ToolTip="Quick folders" AutomationProperties.Name="Quick folders" Checked="ToggleFolders" Unchecked="ToggleFolders" />
            <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Width="34" Height="34" Padding="0" Margin="8,0,0,0"
                    ToolTip="Split pane" AutomationProperties.Name="Split pane" Click="SplitButton">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Split right" Tag="right" InputGestureText="Alt+Shift+Right" Click="SplitMenu" />
                        <MenuItem Header="Split down" Tag="down" InputGestureText="Alt+Shift+Down" Click="SplitMenu" />
                        <MenuItem Header="Split left" Tag="left" InputGestureText="Alt+Shift+Left" Click="SplitMenu" />
                        <MenuItem Header="Split up" Tag="up" InputGestureText="Alt+Shift+Up" Click="SplitMenu" />
                        <Separator />
                        <MenuItem Header="Close pane" InputGestureText="Ctrl+Shift+W" Click="ClosePaneMenu" />
                    </ContextMenu>
                </Button.ContextMenu>
                <Path Width="16" Height="16" Stretch="Uniform" StrokeThickness="1.4" StrokeLineJoin="Round"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      Data="M4,3.5 H16 Q16.5,3.5 16.5,4 V16 Q16.5,16.5 16,16.5 H4 Q3.5,16.5 3.5,16 V4 Q3.5,3.5 4,3.5 Z M10,3.5 V16.5" />
            </Button>
        <DockPanel x:Name="Strip" HorizontalAlignment="Left">
            <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Width="34" Height="34" Padding="0" Margin="2,0,0,0"
                    Content="&#xE710;" FontFamily="{StaticResource Icons}" FontSize="13" Click="NewShell"
                    ToolTip="New terminal (right-click for Claude Code)" AutomationProperties.Name="New terminal">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="New terminal" Click="NewShell" />
                        <MenuItem x:Name="ClaudeItem" Header="New Claude Code tab" Click="NewClaude" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
            <ListBox x:Name="TabList" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource TabChip}"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                     SelectionChanged="TabSelected" AllowDrop="True" PreviewMouseMove="TabDragMove" DragOver="TabDragOver"
                     PreviewMouseWheel="TabWheel">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Background="Transparent" MouseLeftButtonDown="TabMouseDown">
                            <StackPanel.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Rename" Click="Rename" />
                                    <MenuItem StaysOpenOnClick="True">
                                        <MenuItem.Header>
                                            <ItemsControl ItemsSource="{x:Static local:CliPage.Palette}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Click="SetColor" Tag="{Binding}" Padding="0" Margin="0,0,6,0" Background="Transparent">
                                                            <Ellipse Width="16" Height="16" Fill="{Binding}" />
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <MenuItem Header="Split right" Tag="right" InputGestureText="Alt+Shift+Right" Click="SplitMenu" />
                                    <MenuItem Header="Split down" Tag="down" InputGestureText="Alt+Shift+Down" Click="SplitMenu" />
                                    <MenuItem Header="Split left" Tag="left" InputGestureText="Alt+Shift+Left" Click="SplitMenu" />
                                    <MenuItem Header="Split up" Tag="up" InputGestureText="Alt+Shift+Up" Click="SplitMenu" />
                                    <MenuItem Header="Duplicate" Click="Duplicate" />
                                    <MenuItem Header="Close" Click="CloseTab" />
                                </ContextMenu>
                            </StackPanel.ContextMenu>
                            <Ellipse Width="8" Height="8" Fill="{Binding Brush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Grid VerticalAlignment="Center">
                                <TextBlock x:Name="Label" Text="{Binding Name}"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                <TextBox x:Name="Edit" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Visibility="Collapsed"
                                         MinWidth="90" Padding="2,0" Background="Transparent" BorderThickness="0"
                                         IsVisibleChanged="EditShown" KeyDown="EditKey" LostKeyboardFocus="EditDone" />
                            </Grid>
                            <Button Style="{StaticResource Ghost}" Content="&#xE711;" FontFamily="{StaticResource Icons}" FontSize="9"
                                    Padding="6,3" Margin="6,0,0,0" ToolTip="Close" Click="CloseTab"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Editing}" Value="True">
                                <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Edit" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- All terminals render in this one WebView (Terminal\term.html), transparent so the glass shows through -->
            <Border x:Name="Screen" Style="{StaticResource Card}" Padding="10" Margin="0" Background="#38000000">
                <Grid>
                    <wv2:WebView2 x:Name="Web" />
                    <StackPanel x:Name="Empty" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#xE756;" FontFamily="{StaticResource Icons}" FontSize="32" Foreground="{StaticResource Sub}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Style="{StaticResource Label}" Margin="0,10,0,0" Text="No terminals. Open one with + at the top." />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Quick folders (closed until the folder button is pressed) -->
            <Border x:Name="FolderPanel" Grid.Column="1" Style="{StaticResource Card}" Width="210" Margin="10,0,0,0" Visibility="Collapsed">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="&#xE711;" FontFamily="{StaticResource Icons}"
                                FontSize="11" ToolTip="Close" AutomationProperties.Name="Close folders" Click="CloseFolders" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="&#xE710;" FontFamily="{StaticResource Icons}"
                                FontSize="12" ToolTip="Add folder" Click="AddFolder" />
                        <TextBlock Style="{StaticResource H}" Text="Folders" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Label}" FontSize="11" TextWrapping="Wrap" Margin="2,8,0,0"
                               Text="Click: cd in this tab. Right-click: more." />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="Folders">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Ghost}" HorizontalContentAlignment="Stretch" Padding="10,7" Margin="0,1"
                                            ToolTip="{Binding}" Click="GoFolder">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Open in new tab" Click="FolderNewTab" />
                                                <MenuItem Header="Claude here" Click="FolderClaude" />
                                                <MenuItem Header="Show in Explorer" Click="FolderExplorer" />
                                                <MenuItem Header="Remove from list" Click="FolderRemove" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                            <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center"
                                                       Foreground="{StaticResource Accent}" Margin="0,0,10,0" />
                                            <TextBlock Text="{Binding Converter={x:Static local:CliPage.Leaf}}" TextTrimming="CharacterEllipsis"
                                                       MaxWidth="130" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
