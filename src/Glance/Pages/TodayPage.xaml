<UserControl x:Class="Glance.Pages.TodayPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="KpiValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,4,0,2" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="KpiCell" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
            <Setter Property="Padding" Value="20,14" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid MinHeight="560" Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- KPI strip: what's due, what's next, money. Cells for pages that are off (or empty) stay out. -->
            <Border Style="{StaticResource Card}" Padding="0">
                <UniformGrid x:Name="Kpis" Rows="1">
                    <Border x:Name="DueCell" Style="{StaticResource KpiCell}" MouseLeftButtonUp="GoTasks" ToolTip="Open Tasks">
                        <StackPanel>
                            <TextBlock Text="Due today" Style="{StaticResource Caption}" />
                            <TextBlock x:Name="DueValue" Text="—" Style="{StaticResource KpiValue}" />
                            <TextBlock x:Name="DueSub" Style="{StaticResource Caption}" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="NextCell" Style="{StaticResource KpiCell}" MouseLeftButtonUp="GoNext">
                        <StackPanel>
                            <TextBlock Text="Next up" Style="{StaticResource Caption}" />
                            <TextBlock x:Name="NextValue" Text="—" Style="{StaticResource KpiValue}" />
                            <TextBlock x:Name="NextSub" Style="{StaticResource Caption}" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="BillsCell" Style="{StaticResource KpiCell}" MouseLeftButtonUp="GoBills" ToolTip="Open Bills">
                        <StackPanel>
                            <TextBlock Text="Bills this week" Style="{StaticResource Caption}" />
                            <TextBlock x:Name="BillsValue" Text="—" Style="{StaticResource KpiValue}" />
                            <TextBlock x:Name="BillsSub" Style="{StaticResource Caption}" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="SpentCell" Style="{StaticResource KpiCell}" MouseLeftButtonUp="GoBudget" ToolTip="Open Budget">
                        <StackPanel>
                            <TextBlock x:Name="SpentCaption" Text="Spent this month" Style="{StaticResource Caption}" />
                            <TextBlock x:Name="SpentValue" Text="—" Style="{StaticResource KpiValue}" />
                            <TextBlock x:Name="SpentSub" Style="{StaticResource Caption}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.7*" />
                    <ColumnDefinition x:Name="SideCol" Width="*" MinWidth="290" />
                </Grid.ColumnDefinitions>

                <!-- The week: late, today, then the next six days -->
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock x:Name="AgendaCount" DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                            <TextBlock Text="This week" Style="{StaticResource H}" />
                        </DockPanel>
                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="Agenda" />
                            </ScrollViewer>
                            <StackPanel x:Name="AgendaEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="340" Visibility="Collapsed">
                                <TextBlock Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="26" Foreground="{StaticResource Green}" HorizontalAlignment="Center" />
                                <TextBlock Text="Nothing due this week" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0" />
                                <TextBlock x:Name="AgendaHint" Style="{StaticResource Label}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </Border>

                <Grid x:Name="Side" Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Weather now and the next hours -->
                    <Border x:Name="WeatherCard" Style="{StaticResource Card}" Cursor="Hand" MouseLeftButtonUp="GoWeather" ToolTip="Open Weather">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock x:Name="WxGlyph" DockPanel.Dock="Left" FontSize="34" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBlock x:Name="WxTemp" DockPanel.Dock="Left" Style="{StaticResource Big}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="WxText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="WxSub" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                            <UniformGrid x:Name="WxHours" Rows="1" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Today's note: Enter adds a line, like quick capture -->
                    <Border x:Name="NoteCard" Grid.Row="1" Style="{StaticResource Card}">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Open" Padding="8,3" Click="OpenNote" ToolTip="Open today's note in Notes" />
                                <TextBlock Text="Today's note" Style="{StaticResource H}" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBox x:Name="Jot" DockPanel.Dock="Top" Tag="Jot something down, Enter adds it" KeyDown="JotKey" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                                <TextBlock x:Name="NoteText" TextWrapping="Wrap" LineHeight="21" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
