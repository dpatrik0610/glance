<UserControl x:Class="Glance.Pages.StartupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:g="clr-namespace:Glance">
    <UserControl.Resources>
        <Style x:Key="Act" TargetType="Button" BasedOn="{StaticResource Ghost}">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Foreground" Value="{StaticResource Sub}" />
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <TextBlock x:Name="Count" DockPanel.Dock="Top" Style="{StaticResource Label}" />
        <!-- Title row bar (IHeader): what to show, Windows' own entries, refresh -->
        <StackPanel x:Name="Bar" DockPanel.Dock="Top" Orientation="Horizontal">
            <Border Style="{StaticResource Segment}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton Style="{StaticResource Chip}" GroupName="startupKind" Content="All" Tag="" IsChecked="True" Checked="KindPicked" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="startupKind" Content="Apps" Tag="Apps" Checked="KindPicked"
                                 ToolTip="Run keys and Startup folders: what Task Manager lists" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="startupKind" Content="Tasks" Tag="Task" Checked="KindPicked"
                                 ToolTip="Scheduled tasks that run at sign-in or boot, hidden ones too" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="startupKind" Content="Services" Tag="Service" Checked="KindPicked"
                                 ToolTip="Services that start automatically" />
                </StackPanel>
            </Border>
            <CheckBox x:Name="WindowsBox" Style="{StaticResource Switch}" Content="Windows  " Margin="14,0,4,0" VerticalAlignment="Center"
                      Click="WindowsToggled" ToolTip="Also list Windows' own entries (programs under the Windows folder, \Microsoft tasks)" />
            <Button Style="{StaticResource Ghost}" Content="&#xE72C;" FontFamily="{StaticResource Icons}" ToolTip="Refresh (F5)" Click="Refresh" />
        </StackPanel>
        <Grid x:Name="Columns" DockPanel.Dock="Top" Margin="12,4,14,7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.6*" />
                <ColumnDefinition Width="1.4*" />
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="140" />
            </Grid.ColumnDefinitions>
            <Border Grid.ColumnSpan="9" Height="1" VerticalAlignment="Bottom" Margin="-12,0,-14,-7" Background="{StaticResource Line}" />
            <TextBlock Text="Name" Style="{StaticResource Label}" />
            <TextBlock Grid.Column="1" Text="Started by" Style="{StaticResource Label}" />
            <TextBlock Grid.Column="2" Text="On" Style="{StaticResource Label}" />
        </Grid>
        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="Rows">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- A row: name over its command, where it's registered, the switch; actions show on hover -->
                            <Border x:Name="Row" Margin="0,0,10,0" Padding="12,10,4,10" Background="Transparent" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.6*" />
                                        <ColumnDefinition Width="1.4*" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel x:Name="NameCell" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="  file missing" FontSize="12" Foreground="{StaticResource Amber}" VerticalAlignment="Bottom"
                                                       Visibility="{Binding Missing, Converter={StaticResource Vis}}" ToolTip="{Binding File}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Command}" FontFamily="{StaticResource Mono}" FontSize="12" Margin="0,2,0,0"
                                                   Foreground="{StaticResource Sub}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Command}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding KindText}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding WhereText}" FontFamily="{StaticResource Mono}" FontSize="12" Margin="0,2,0,0"
                                                   Foreground="{StaticResource Sub}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Where}" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding Enabled, Mode=OneWay}" Click="Toggled"
                                              VerticalAlignment="Center" HorizontalAlignment="Left"
                                              Visibility="{Binding CanToggle, Converter={StaticResource Vis}}" />
                                    <TextBlock x:Name="Always" Grid.Column="2" Text="Always" Style="{StaticResource Label}" VerticalAlignment="Center"
                                               ToolTip="Windows has no off switch for RunOnce and policy entries. Remove the value in Registry Editor (Source)." />
                                    <StackPanel x:Name="Actions" Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" Opacity="0">
                                        <Button Style="{StaticResource Act}" Content="File" ToolTip="Show the program in Explorer" Click="ShowFile" />
                                        <Button Style="{StaticResource Act}" Content="Source" ToolTip="Open where it's registered" Click="ShowSource" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding CanToggle}" Value="True">
                                    <Setter TargetName="Always" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Enabled}" Value="False">
                                    <Setter TargetName="NameCell" Property="Opacity" Value="0.55" />
                                </DataTrigger>
                                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="{StaticResource CardBg}" />
                                    <Setter TargetName="Actions" Property="Opacity" Value="1" />
                                </Trigger>
                                <Trigger SourceName="Row" Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="Actions" Property="Opacity" Value="1" />
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <StackPanel x:Name="Empty" HorizontalAlignment="Center" VerticalAlignment="Center">
                <g:Logo Width="44" Height="44" Margin="0,0,0,12" Status="{Binding Text, ElementName=EmptyText}" />
                <TextBlock x:Name="EmptyText" Text="Loading…" Style="{StaticResource Label}" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
