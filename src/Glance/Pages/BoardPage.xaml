<UserControl x:Class="Glance.Pages.BoardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" FocusVisualStyle="{x:Null}" KeyDown="KeyPressed">
    <Border Style="{StaticResource Card}" Padding="0">
        <!-- Dotted canvas: drag the background to pan, scroll to zoom. Items live on World, which pans and zooms. -->
        <Grid x:Name="Surface" ClipToBounds="True" AllowDrop="True" Margin="1"
              MouseDown="SurfaceDown" MouseMove="SurfaceMove" MouseUp="SurfaceUp" PreviewMouseWheel="Wheel" Drop="Dropped">
            <Grid.Background>
                <DrawingBrush x:Name="Dots" TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,24,24" ViewboxUnits="Absolute" Viewbox="0,0,24,24">
                    <DrawingBrush.Drawing>
                        <DrawingGroup Opacity="0.4">
                            <GeometryDrawing Brush="{StaticResource Sub}">
                                <GeometryDrawing.Geometry>
                                    <EllipseGeometry Center="12,12" RadiusX="1.1" RadiusY="1.1" />
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingGroup>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Grid.Background>

            <Canvas x:Name="World" />

            <TextBlock x:Name="Hint" Style="{StaticResource Label}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center" IsHitTestVisible="False" LineHeight="22"
                       Text="Double-click to add a note (Markdown works, double-click a note to edit it)&#10;Paste or drop pictures and text&#10;Drag the background to move around, scroll to zoom" />

            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Orientation="Horizontal">
                <TextBlock x:Name="ZoomText" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Button Style="{StaticResource Ghost}" Content="&#xE8A3;" FontFamily="{StaticResource Icons}" ToolTip="Back to 100%" Click="ResetView" />
                <Button Margin="6,0,0,0" Click="AddNote" ToolTip="New note (or double-click the board)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Note" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
