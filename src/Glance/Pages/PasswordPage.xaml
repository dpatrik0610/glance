<UserControl x:Class="Glance.Pages.PasswordPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel MaxWidth="680" HorizontalAlignment="Left" Width="680">
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBox x:Name="Output" IsReadOnly="True" FontFamily="{StaticResource Mono}" FontSize="22" Padding="16,12" />
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <ProgressBar x:Name="Strength" Maximum="128" Width="220" HorizontalAlignment="Left" />
                        <TextBlock x:Name="StrengthText" Style="{StaticResource Label}" Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="↻ New" Click="Generate" Margin="0,0,8,0" />
                        <Button Style="{StaticResource Primary}" Content="Copy" Click="Copy" />
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="Status" Style="{StaticResource Label}" Margin="0,10,0,0" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <DockPanel Margin="0,0,0,14">
                    <TextBlock x:Name="LengthText" DockPanel.Dock="Right" Width="44" TextAlignment="Right" Style="{StaticResource Label}" />
                    <TextBlock Text="Length" Width="150" VerticalAlignment="Center" />
                    <Slider x:Name="Length" Minimum="8" Maximum="64" Value="20" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="Generate" />
                </DockPanel>
                <CheckBox x:Name="UpperBox" Style="{StaticResource Switch}" Content="Uppercase (A–Z)" IsChecked="True" Margin="0,0,0,12" Click="Generate" />
                <CheckBox x:Name="LowerBox" Style="{StaticResource Switch}" Content="Lowercase (a–z)" IsChecked="True" Margin="0,0,0,12" Click="Generate" />
                <CheckBox x:Name="DigitBox" Style="{StaticResource Switch}" Content="Numbers (0–9)" IsChecked="True" Margin="0,0,0,12" Click="Generate" />
                <CheckBox x:Name="SymbolBox" Style="{StaticResource Switch}" Content="Symbols (!@#…)" IsChecked="True" Margin="0,0,0,12" Click="Generate" />
                <CheckBox x:Name="SimilarBox" Style="{StaticResource Switch}" Content="Avoid look-alikes (I l 1 O 0 o)" Click="Generate" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
