<UserControl x:Class="Glance.Pages.CloudflarePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:g="clr-namespace:Glance">
    <UserControl.Resources>
        <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="Note" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="8,6" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="KpiValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,4,0,2" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="KpiCell" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
            <Setter Property="Padding" Value="20,14" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <!-- Icon-only button: dim until hovered -->
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource Ghost}">
            <Setter Property="FontFamily" Value="{StaticResource Icons}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Foreground" Value="{StaticResource Sub}" />
        </Style>
        <!-- Rounded square with a glyph, tinted by kind -->
        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Icons}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Status pill: tinted background, colored dot and word (Live, Building, Failed) -->
        <DataTemplate x:Key="StatusPill">
            <Border CornerRadius="10" Padding="8,2,9,2" Background="{Binding StatusBg}" HorizontalAlignment="Left" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Fill="{Binding StatusBrush}" Margin="0,1,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Deploy.StatusText}" Foreground="{Binding StatusBrush}" FontSize="11.5" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <!-- List rows: hover tint, selected tint with an accent bar -->
        <Style x:Key="RowItem" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="b" CornerRadius="10" Padding="8,7" Margin="0,1" Background="Transparent">
                            <Grid>
                                <Border x:Name="bar" Width="3" CornerRadius="1.5" HorizontalAlignment="Left" Margin="-8,5,0,5"
                                        Background="{StaticResource Accent}" Opacity="0" />
                                <ContentPresenter />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#0DFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#17FFFFFF" />
                                <Setter TargetName="bar" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HoverRow" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0DFFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Fills the window; scrolls only once it's shorter than the dashboard needs -->
        <ScrollViewer x:Name="Body" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <Grid MinHeight="660" Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Verdict: are the deploys healthy, and what's in the account -->
                <DockPanel Margin="8,2,6,10">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="Updated" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0"
                                   ToolTip="Refreshes every minute while this page is open" />
                        <Button x:Name="RefreshButton" Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Refresh (F5)" Click="Refresh" />
                        <Button Style="{StaticResource Ghost}" Margin="4,0,0,0" Click="OpenDashboard" ToolTip="Open this account on dash.cloudflare.com">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Dashboard" />
                                <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource Icons}" FontSize="11" VerticalAlignment="Center" Margin="7,1,0,0" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="MoreButton" Style="{StaticResource IconButton}" Content="&#xE712;" Margin="4,0,0,0" ToolTip="More" Click="MoreClick">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Copy account ID" Click="CopyAccountId" />
                                    <MenuItem Header="Disconnect…" Click="DisconnectClick" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                    <Border x:Name="Badge" Width="44" Height="44" CornerRadius="14" Background="{StaticResource PillBg}" VerticalAlignment="Center">
                        <TextBlock x:Name="BadgeIcon" Style="{StaticResource Glyph}" FontSize="20" Text="&#xE753;" Foreground="{StaticResource Sub}" />
                    </Border>
                    <StackPanel Margin="14,0,16,0" VerticalAlignment="Center">
                        <TextBlock x:Name="Verdict" Text="Loading…" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="Summary" Style="{StaticResource Label}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>

                <!-- Can't reach Cloudflare at all: say why, offer a retry (and a new token when it's the token) -->
                <Border x:Name="Banner" Grid.Row="1" Margin="6,0,6,6" Padding="14,10" CornerRadius="12" Background="#26FF5A5A"
                        BorderBrush="#4DFF5A5A" BorderThickness="1" Visibility="Collapsed">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="ReconnectButton" Style="{StaticResource Ghost}" Content="Use another token" Margin="0,0,6,0" Click="Reconnect" />
                            <Button Content="Try again" Click="Refresh" />
                        </StackPanel>
                        <TextBlock Text="&#xE783;" FontFamily="{StaticResource Icons}" FontSize="16" Foreground="{StaticResource Red}" VerticalAlignment="Center"
                                   Margin="0,0,12,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Couldn't load from Cloudflare" FontWeight="SemiBold" />
                            <TextBlock x:Name="BannerText" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- KPI strip: Worker traffic over 24 hours, and the newest deploy -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.3*" />
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition Width="1.2*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource KpiCell}" BorderThickness="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Requests · 24 h" Style="{StaticResource Caption}" />
                                    <TextBlock x:Name="ReqValue" Text="—" Style="{StaticResource KpiValue}" />
                                    <TextBlock x:Name="ReqSub" Style="{StaticResource Caption}" />
                                </StackPanel>
                                <g:Spark x:Name="ReqChart" Grid.Column="1" Height="44" Margin="18,4,0,0" VerticalAlignment="Center" Color="#F38020" Max="0"
                                         Format="{}{0:N0} requests" />
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource KpiCell}">
                            <StackPanel>
                                <TextBlock Text="Error rate" Style="{StaticResource Caption}" />
                                <TextBlock x:Name="ErrValue" Text="—" Style="{StaticResource KpiValue}" />
                                <TextBlock x:Name="ErrSub" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource KpiCell}"
                                ToolTip="CPU time a request typically takes (each hour's median, weighted by its requests)">
                            <StackPanel>
                                <TextBlock Text="CPU time · typical" Style="{StaticResource Caption}" />
                                <TextBlock x:Name="CpuValue" Text="—" Style="{StaticResource KpiValue}" />
                                <TextBlock x:Name="CpuSub" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="LastCell" Grid.Column="3" Style="{StaticResource KpiCell}" Cursor="Hand" MouseLeftButtonUp="OpenLast"
                                ToolTip="Click to open it">
                            <StackPanel>
                                <TextBlock Text="Last deploy" Style="{StaticResource Caption}" />
                                <TextBlock x:Name="LastValue" Text="—" Style="{StaticResource KpiValue}" />
                                <TextBlock x:Name="LastSub" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.75*" />
                        <ColumnDefinition Width="*" MinWidth="300" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="200" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Workers and Pages: filter, search, pick one for its details -->
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel x:Name="KindChips" Orientation="Horizontal" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <Grid Width="180">
                                        <TextBox x:Name="Search" Tag="Search  (Ctrl+F)" Padding="14,6,4,6" TextChanged="SearchChanged" />
                                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{StaticResource Sub}"
                                                   VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Projects" Style="{StaticResource H}" />
                                    <TextBlock x:Name="AppsCount" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="8,0,8,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="128" />
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="68" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="Name · latest change" Style="{StaticResource Caption}" />
                                <TextBlock Grid.Column="2" Text="Status" Style="{StaticResource Caption}" />
                                <TextBlock Grid.Column="3" Text="Requests · 24 h" Style="{StaticResource Caption}" />
                                <TextBlock Grid.Column="4" Text="Deployed" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                            </Grid>
                            <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,0,0,4" />
                            <TextBlock x:Name="AppsNote" DockPanel.Dock="Top" Style="{StaticResource Note}" Text="Loading…" />
                            <ListBox x:Name="Apps" Background="Transparent" BorderThickness="0" Padding="0" ItemContainerStyle="{StaticResource RowItem}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="AppSelected">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44" />
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="96" />
                                                <ColumnDefinition Width="128" />
                                                <ColumnDefinition Width="84" />
                                                <ColumnDefinition Width="68" />
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource Tile}" Background="{Binding KindBg}" HorizontalAlignment="Left" ToolTip="{Binding Kind}">
                                                <TextBlock Style="{StaticResource Glyph}" Text="{Binding Icon}" Foreground="{Binding KindBrush}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Deploy.Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Kind}" Style="{StaticResource Caption}" FontSize="11" Margin="8,1,0,0" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Deploy.Title}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"
                                                           Margin="0,2,0,0" ToolTip="{Binding Deploy.Line}" />
                                            </StackPanel>
                                            <ContentPresenter Grid.Column="2" Content="{Binding}" ContentTemplate="{StaticResource StatusPill}" />
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                                                        Visibility="{Binding HasTraffic, Converter={StaticResource Vis}}">
                                                <g:Spark Width="64" Height="24" Series="{Binding Hourly}" Color="#F38020" Max="0" Format="{}{0:N0} requests"
                                                         Step="01:00:00" />
                                                <TextBlock Text="{Binding Requests}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="4" Text="{Binding Deploy.Ago}" Style="{StaticResource Caption}" HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" ToolTip="{Binding Deploy.WhenText}" />
                                            <!-- Shown on hover / selection -->
                                            <StackPanel x:Name="Actions" Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right" Opacity="0">
                                                <Button Style="{StaticResource IconButton}" Content="&#xE8A7;" Padding="6,5" ToolTip="{Binding Deploy.Url}"
                                                        Click="OpenSite" Visibility="{Binding HasUrl, Converter={StaticResource Vis}}" />
                                                <Button Style="{StaticResource IconButton}" Content="&#xE753;" Padding="6,5" ToolTip="Open in Cloudflare"
                                                        Click="OpenInDash" />
                                            </StackPanel>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter TargetName="Actions" Property="Opacity" Value="1" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter TargetName="Actions" Property="Opacity" Value="1" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <!-- Domains and storage, side by side under the projects -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" MaxHeight="250">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <TextBlock x:Name="ZonesCount" DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                    <TextBlock Text="Domains" Style="{StaticResource H}" />
                                </DockPanel>
                                <TextBlock x:Name="ZonesNote" DockPanel.Dock="Top" Style="{StaticResource Note}" />
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="Zones">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource HoverRow}" MouseLeftButtonUp="OpenZone" ToolTip="Open in Cloudflare">
                                                    <DockPanel>
                                                        <ContentPresenter DockPanel.Dock="Right" Content="{Binding}">
                                                            <ContentPresenter.ContentTemplate>
                                                                <DataTemplate>
                                                                    <Border CornerRadius="10" Padding="8,2" Background="{Binding StatusBg}" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontSize="11.5"
                                                                                   FontWeight="SemiBold" />
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ContentPresenter.ContentTemplate>
                                                        </ContentPresenter>
                                                        <Border Style="{StaticResource Tile}" Width="28" Height="28" CornerRadius="8" Background="#265AA9FF">
                                                            <TextBlock Style="{StaticResource Glyph}" FontSize="12.5" Text="&#xE774;" Foreground="#5AA9FF" />
                                                        </Border>
                                                        <StackPanel Margin="10,0,8,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Zone.Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Zone.Plan}" Style="{StaticResource Caption}" FontSize="11" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}" MaxHeight="250">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <TextBlock x:Name="StoresCount" DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                    <TextBlock Text="Storage" Style="{StaticResource H}" />
                                </DockPanel>
                                <TextBlock x:Name="StorageNote" DockPanel.Dock="Top" Style="{StaticResource Note}" />
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="Stores">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource HoverRow}" MouseLeftButtonUp="OpenStore" ToolTip="Open in Cloudflare">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Store.Size}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        <Border Style="{StaticResource Tile}" Width="28" Height="28" CornerRadius="8" Background="{Binding KindBg}">
                                                            <TextBlock Text="{Binding Store.Kind}" FontFamily="{StaticResource Mono}" FontSize="10.5" FontWeight="Bold"
                                                                       Foreground="{Binding KindBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <StackPanel Margin="10,0,8,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Store.Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Store.Detail}" Style="{StaticResource Caption}" FontSize="11" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- Right: recent deploys across the account, or one project's details when picked -->
                    <Border Grid.Column="1" Grid.RowSpan="2" Style="{StaticResource Card}">
                        <Grid>
                            <DockPanel x:Name="Activity">
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                    <TextBlock Text="Recent deploys" Style="{StaticResource H}" />
                                    <TextBlock Text="Newest first · click one for its details" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                </StackPanel>
                                <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,0,0,6" />
                                <TextBlock x:Name="ActivityNote" DockPanel.Dock="Top" Style="{StaticResource Note}" />
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="Feed">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource HoverRow}" Padding="6,8" MouseLeftButtonUp="FeedClick">
                                                    <DockPanel>
                                                        <Border Width="3" CornerRadius="1.5" Background="{Binding StatusBrush}" Margin="0,2,12,2" />
                                                        <StackPanel DockPanel.Dock="Right" Margin="10,0,0,0">
                                                            <TextBlock Text="{Binding Deploy.Ago}" Style="{StaticResource Caption}" FontSize="11" HorizontalAlignment="Right"
                                                                       ToolTip="{Binding Deploy.WhenText}" />
                                                            <TextBlock Text="{Binding Deploy.StatusText}" Foreground="{Binding StatusBrush}" FontSize="11"
                                                                       FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,3,0,0" />
                                                        </StackPanel>
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="{Binding KindBrush}"
                                                                           VerticalAlignment="Center" Margin="0,1,6,0" />
                                                                <TextBlock Text="{Binding Deploy.Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Deploy.Title}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                            <TextBlock Text="{Binding Deploy.Meta}" Style="{StaticResource Caption}" FontSize="11" FontFamily="{StaticResource Mono}"
                                                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0" Opacity="0.8" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>

                            <!-- One project: links, its traffic (Workers), and a timeline of its deployments -->
                            <DockPanel x:Name="Detail" Visibility="Collapsed">
                                <DockPanel DockPanel.Dock="Top" Margin="-8,-6,0,10">
                                    <ContentPresenter DockPanel.Dock="Right" Content="{Binding}" ContentTemplate="{StaticResource StatusPill}" />
                                    <Button Style="{StaticResource Ghost}" HorizontalAlignment="Left" Click="CloseDetail" ToolTip="Back to recent deploys (Esc)">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE72B;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Text="Recent deploys" />
                                        </StackPanel>
                                    </Button>
                                </DockPanel>
                                <DockPanel DockPanel.Dock="Top">
                                    <Border Style="{StaticResource Tile}" Width="40" Height="40" CornerRadius="11" Background="{Binding KindBg}">
                                        <TextBlock Style="{StaticResource Glyph}" FontSize="17" Text="{Binding Icon}" Foreground="{Binding KindBrush}" />
                                    </Border>
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Deploy.Name}" Style="{StaticResource H}" FontSize="17" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0">
                                            <Run Text="{Binding Kind, Mode=OneWay}" /><Run Text=" · deployed " /><Run Text="{Binding Deploy.Ago, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock DockPanel.Dock="Top" Margin="0,10,0,0" TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding HasUrl, Converter={StaticResource Vis}}">
                                    <Hyperlink NavigateUri="{Binding Deploy.Url}" RequestNavigate="Navigate" Foreground="{StaticResource Accent}">
                                        <Run Text="{Binding Deploy.Url, Mode=OneWay}" />
                                    </Hyperlink>
                                </TextBlock>
                                <WrapPanel DockPanel.Dock="Top" Margin="0,12,0,0">
                                    <Button Style="{StaticResource Primary}" Margin="0,0,6,6" Click="OpenSite"
                                            Visibility="{Binding HasUrl, Converter={StaticResource Vis}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Visit" Foreground="{StaticResource OnAccent}" />
                                            <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource Icons}" FontSize="11" VerticalAlignment="Center" Margin="7,1,0,0"
                                                       Foreground="{StaticResource OnAccent}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Content="Open in Cloudflare" Margin="0,0,6,6" Click="OpenInDash" />
                                    <Button Style="{StaticResource Ghost}" Content="Copy URL" Margin="0,0,6,6" Click="CopyUrl"
                                            Visibility="{Binding HasUrl, Converter={StaticResource Vis}}" />
                                </WrapPanel>

                                <!-- Workers: the last 24 hours -->
                                <Border DockPanel.Dock="Top" Background="#0AFFFFFF" CornerRadius="12" Padding="14,12" Margin="0,8,0,0"
                                        Visibility="{Binding HasTraffic, Converter={StaticResource Vis}}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Requests" Style="{StaticResource Caption}" FontSize="11" />
                                                <TextBlock Text="{Binding Requests}" FontSize="16" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Errors" Style="{StaticResource Caption}" FontSize="11" />
                                                <TextBlock Text="{Binding Errors}" FontSize="16" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="CPU time" Style="{StaticResource Caption}" FontSize="11" />
                                                <TextBlock Text="{Binding Cpu}" FontSize="16" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Grid>
                                        <g:Spark Height="64" Margin="0,10,0,0" Series="{Binding Hourly}" Color="#F38020" Max="0" Format="{}{0:N0} requests"
                                                 Step="01:00:00" />
                                        <DockPanel Margin="0,4,0,0">
                                            <TextBlock DockPanel.Dock="Right" Text="now" Style="{StaticResource Caption}" FontSize="10.5" />
                                            <TextBlock Text="24 h ago" Style="{StaticResource Caption}" FontSize="10.5" />
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <DockPanel DockPanel.Dock="Top" Margin="0,16,0,8">
                                    <TextBlock x:Name="HistoryNote" DockPanel.Dock="Right" Style="{StaticResource Caption}" FontSize="11" />
                                    <TextBlock Text="Deployments" Style="{StaticResource Caption}" FontWeight="SemiBold" />
                                </DockPanel>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="History">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <!-- Timeline: a dot per deployment on a thin rail -->
                                                <Border x:Name="Item" Style="{StaticResource HoverRow}" Padding="0,0,6,0" Cursor="Arrow" MouseLeftButtonUp="HistoryClick">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="24" />
                                                            <ColumnDefinition />
                                                        </Grid.ColumnDefinitions>
                                                        <Rectangle x:Name="Rail" Width="1.5" Fill="{StaticResource Line}" HorizontalAlignment="Center" Margin="0,18,0,0" />
                                                        <Ellipse Width="10" Height="10" Fill="{Binding StatusBrush}" VerticalAlignment="Top" Margin="0,9,0,0"
                                                                 Stroke="{StaticResource PillBg}" StrokeThickness="2" ToolTip="{Binding Deploy.StatusText}" />
                                                        <StackPanel Grid.Column="1" Margin="6,5,0,12">
                                                            <DockPanel>
                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Deploy.Ago}" Style="{StaticResource Caption}" FontSize="11"
                                                                           ToolTip="{Binding Deploy.WhenText}" Margin="8,0,0,0" />
                                                                <TextBlock Text="{Binding Deploy.Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                                           ToolTip="{Binding Deploy.Title}" />
                                                            </DockPanel>
                                                            <TextBlock Text="{Binding Deploy.Meta}" Style="{StaticResource Caption}" FontSize="11" FontFamily="{StaticResource Mono}"
                                                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                            <TextBlock x:Name="State" Text="{Binding Deploy.StatusText}" Foreground="{Binding StatusBrush}" FontSize="11"
                                                                       FontWeight="SemiBold" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Last}" Value="True">
                                                        <Setter TargetName="Rail" Property="Visibility" Value="Hidden" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Deploy.Status}" Value="success">
                                                        <Setter TargetName="State" Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HasUrl}" Value="True">
                                                        <Setter TargetName="Item" Property="Cursor" Value="Hand" />
                                                        <Setter TargetName="Item" Property="ToolTip" Value="{Binding Deploy.Url}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- Not connected: a read-only token in two steps -->
        <Border x:Name="ConnectCard" Style="{StaticResource Card}" Background="{StaticResource Popup}" VerticalAlignment="Center" HorizontalAlignment="Center"
                Width="500" Padding="26,24" Visibility="Collapsed">
            <StackPanel>
                <Border Style="{StaticResource Tile}" Width="48" Height="48" CornerRadius="14" Background="#26F38020" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource Glyph}" FontSize="22" Text="&#xE753;" Foreground="#F38020" />
                </Border>
                <TextBlock Text="Connect Cloudflare" Style="{StaticResource H}" FontSize="19" Margin="0,14,0,4" />
                <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap" LineHeight="19"
                           Text="Your Workers, Pages, domains and storage in one place, and an alert when a deploy goes live or a build fails." />

                <DockPanel Margin="0,20,0,0">
                    <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource PillBg}" VerticalAlignment="Top">
                        <TextBlock Text="1" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,2,0,0">
                        <TextBlock Text="Create a read-only API token" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="18" Margin="0,3,0,10"
                                   Text="The link opens Cloudflare with the permissions already picked: Workers Scripts, Pages, Account Analytics, D1, Workers KV, R2 and Zone, all Read. Check them, then Continue to summary → Create Token." />
                        <Button Style="{StaticResource Primary}" HorizontalAlignment="Left" Click="CreateToken">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Create token" Foreground="{StaticResource OnAccent}" />
                                <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource Icons}" FontSize="11" VerticalAlignment="Center" Margin="8,1,0,0"
                                           Foreground="{StaticResource OnAccent}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>

                <DockPanel Margin="0,20,0,0">
                    <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource PillBg}" VerticalAlignment="Top">
                        <TextBlock Text="2" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,2,0,0">
                        <TextBlock Text="Paste it here" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <DockPanel>
                            <Button x:Name="ConnectButton" DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="Connect" Margin="8,0,0,0"
                                    Click="ConnectClick" />
                            <TextBox x:Name="TokenBox" Tag="API token" FontFamily="{StaticResource Mono}" KeyDown="TokenKey" />
                        </DockPanel>
                        <TextBlock x:Name="ConnectStatus" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </DockPanel>

                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,20,0,12" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72E;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{StaticResource Sub}" VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Width="420" Text="Kept encrypted for your Windows user. Glance only reads; it never changes your account." />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- "Copied" toast -->
        <Border x:Name="Toast" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,20" Background="{StaticResource Accent}"
                CornerRadius="14" Padding="14,6" Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock x:Name="ToastText" Foreground="{StaticResource OnAccent}" FontWeight="SemiBold" />
        </Border>
    </Grid>
</UserControl>
