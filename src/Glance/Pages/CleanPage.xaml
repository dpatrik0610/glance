<UserControl x:Class="Glance.Pages.CleanPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:g="clr-namespace:Glance">
    <DockPanel>
        <!-- What the ticked items add up to, as a ring per group, and the two actions -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
            <DockPanel>
                <g:DiskRing x:Name="Ring" DockPanel.Dock="Left" Width="150" Height="150" Margin="0,0,22,0" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button x:Name="MeasureButton" Style="{StaticResource Ghost}" FontFamily="{StaticResource Icons}" Content="&#xE72C;"
                            ToolTip="Measure again" AutomationProperties.Name="Measure again" Margin="0,0,6,0" Click="Measure" />
                    <Button x:Name="CleanButton" Style="{StaticResource Primary}" Content="Clean" MinWidth="96" Click="Clean" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <!-- Groups with something ticked: name and size side by side, the sizes lined up -->
                    <ItemsControl x:Name="Legend" Focusable="False" Grid.IsSharedSizeScope="True" HorizontalAlignment="Left">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Size" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="9" Height="9" Fill="{Binding Brush}" VerticalAlignment="Center" Margin="0,0,9,0" />
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource Sub}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Size}" FontWeight="SemiBold" Margin="20,0,0,0" TextAlignment="Right"
                                               Typography.NumeralAlignment="Tabular" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="Status" Style="{StaticResource Label}" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Groups" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="14,10,0,0">
                                <Ellipse Width="7" Height="7" Fill="{Binding Brush}" VerticalAlignment="Center" Margin="0,0,7,0" />
                                <TextBlock Text="{Binding Name}" Style="{StaticResource Label}" />
                            </StackPanel>
                            <Border Style="{StaticResource Card}" Padding="8">
                                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- The whole row ticks; the box itself is there for the keyboard -->
                                            <Border x:Name="Row" CornerRadius="10" Padding="10,7" Background="Transparent" Cursor="Hand" MouseLeftButtonUp="RowClick">
                                                <DockPanel>
                                                    <CheckBox DockPanel.Dock="Left" Style="{StaticResource Check}" IsChecked="{Binding On}"
                                                              AutomationProperties.Name="{Binding Name}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                    <!-- Cleans just this one, ticked or not; shows on hover -->
                                                    <Button x:Name="One" DockPanel.Dock="Right" Style="{StaticResource Ghost}" FontFamily="{StaticResource Icons}"
                                                            Content="&#xE74D;" ToolTip="Clean only this" AutomationProperties.Name="Clean only this"
                                                            IsEnabled="{Binding CanClean}" Opacity="0" VerticalAlignment="Center" Margin="4,0,0,0" Click="CleanOne" />
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" FontWeight="SemiBold" FontSize="14"
                                                               VerticalAlignment="Center" Margin="12,0,4,0" Typography.NumeralAlignment="Tabular" />
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" />
                                                        <TextBlock Text="{Binding Note}" Foreground="{Binding NoteBrush}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="{StaticResource Track}" />
                                                    <Setter TargetName="One" Property="Opacity" Value="1" />
                                                </Trigger>
                                                <Trigger SourceName="One" Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="One" Property="Opacity" Value="1" />
                                                </Trigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
