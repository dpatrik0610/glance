<UserControl x:Class="Glance.Pages.ComparePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Glance.Pages">
    <UserControl.Resources>
        <Style x:Key="Act" TargetType="Button" BasedOn="{StaticResource Ghost}">
            <Setter Property="FontFamily" Value="{StaticResource Icons}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="Foreground" Value="{StaticResource Sub}" />
        </Style>
        <!-- A slot to drop a file or folder on, or pick one -->
        <Style x:Key="Slot" TargetType="Border">
            <Setter Property="BorderBrush" Value="#2EFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="AllowDrop" Value="True" />
        </Style>
        <!-- Long lists stay fast: only the rows on screen are built -->
        <ControlTemplate x:Key="Scroller" TargetType="ItemsControl">
            <ScrollViewer CanContentScroll="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <ItemsPresenter />
            </ScrollViewer>
        </ControlTemplate>
        <ItemsPanelTemplate x:Key="Rows">
            <VirtualizingStackPanel />
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <Border Style="{StaticResource Card}">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                <RadioButton x:Name="FilesTab" Style="{StaticResource Chip}" GroupName="mode" Content="Files" IsChecked="True" Checked="ModeChanged" />
                <RadioButton x:Name="FoldersTab" Style="{StaticResource Chip}" GroupName="mode" Content="Folders" Checked="ModeChanged" />
                <RadioButton x:Name="DupesTab" Style="{StaticResource Chip}" GroupName="mode" Content="Duplicates" Checked="ModeChanged" />
            </StackPanel>

            <Grid>
                <!-- ===== Files ===== -->
                <DockPanel x:Name="FilesView">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="FileA" Style="{StaticResource Slot}" Drop="FileDropped" DragOver="DraggedOver">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Browse…" Click="PickFile" Tag="A" />
                                <TextBlock x:Name="FileAText" Style="{StaticResource Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Text="Left: drop a file, or two at once" />
                            </DockPanel>
                        </Border>
                        <Border x:Name="FileB" Grid.Column="2" Style="{StaticResource Slot}" Drop="FileDropped" DragOver="DraggedOver">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Browse…" Click="PickFile" Tag="B" />
                                <TextBlock x:Name="FileBText" Style="{StaticResource Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Text="Right: drop a file" />
                            </DockPanel>
                        </Border>
                    </Grid>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button x:Name="SwapButton" DockPanel.Dock="Right" Style="{StaticResource Act}" Content="&#xE8AB;" ToolTip="Swap left and right"
                                Click="Swap" />
                        <TextBlock x:Name="FileSummary" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>
                    <ItemsControl x:Name="DiffList" Template="{StaticResource Scroller}" ItemsPanel="{StaticResource Rows}"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                                  FontFamily="{StaticResource Mono}" FontSize="12.5">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Background="{Binding Converter={x:Static local:ComparePage.RowBrush}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Left}" Foreground="{StaticResource Sub}" TextAlignment="Right" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding Right}" Foreground="{StaticResource Sub}" TextAlignment="Right" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding Kind, Converter={x:Static local:ComparePage.Marker}}"
                                               Foreground="{StaticResource Sub}" />
                                    <TextBlock Grid.Column="3" DataContextChanged="FillLine" Padding="0,1,12,1" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>

                <!-- ===== Folders ===== -->
                <DockPanel x:Name="FoldersView" Visibility="Collapsed">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Slot}" Drop="FolderDropped" DragOver="DraggedOver" Tag="A">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Browse…" Click="PickFolder" Tag="A" />
                                <TextBlock x:Name="FolderAText" Style="{StaticResource Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Text="Left: drop a folder, or two at once" />
                            </DockPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Slot}" Drop="FolderDropped" DragOver="DraggedOver" Tag="B">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Browse…" Click="PickFolder" Tag="B" />
                                <TextBlock x:Name="FolderBText" Style="{StaticResource Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Text="Right: drop a folder" />
                            </DockPanel>
                        </Border>
                    </Grid>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button x:Name="FolderCancel" DockPanel.Dock="Right" Content="Cancel" Click="Cancel" Visibility="Collapsed" />
                        <TextBlock x:Name="FolderSummary" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>
                    <ItemsControl x:Name="FolderList" Template="{StaticResource Scroller}" ItemsPanel="{StaticResource Rows}"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2,10,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="70" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding KindText}" VerticalAlignment="Center"
                                               Foreground="{Binding Kind, Converter={x:Static local:ComparePage.KindBrush}}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Path}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Path}" />
                                    <TextBlock Grid.Column="2" Text="{Binding LeftText}" Style="{StaticResource Label}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding RightText}" Style="{StaticResource Label}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource Act}" Content="&#xE8F9;" ToolTip="Compare the two files" Click="DiffItem"
                                                Visibility="{Binding CanDiff, Converter={StaticResource Vis}}" />
                                        <Button Style="{StaticResource Act}" Content="&#xED25;" ToolTip="Show in Explorer" Click="ShowItem" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>

                <!-- ===== Duplicates ===== -->
                <DockPanel x:Name="DupesView" Visibility="Collapsed">
                    <Border DockPanel.Dock="Top" Style="{StaticResource Slot}" Drop="RootDropped" DragOver="DraggedOver" Margin="0,0,0,10">
                        <DockPanel>
                            <Button x:Name="FindButton" DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="Find duplicates" Click="FindDupes"
                                    Margin="6,0,0,0" IsEnabled="False" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Add folder…" Click="AddRoot" />
                            <TextBlock x:Name="RootsHint" DockPanel.Dock="Left" Style="{StaticResource Label}" VerticalAlignment="Center"
                                       Text="Drop folders here, or add them" />
                            <ItemsControl x:Name="RootList" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="12" Background="#1AFFFFFF" Padding="10,2,2,2" Margin="0,2,6,2">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding}" VerticalAlignment="Center" FontSize="12.5" />
                                                <Button Style="{StaticResource Act}" Content="&#xE711;" FontSize="9" Padding="6,3" ToolTip="Remove"
                                                        Click="RemoveRoot" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                    </Border>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button x:Name="DupeCancel" DockPanel.Dock="Right" Content="Cancel" Click="Cancel" Visibility="Collapsed" />
                        <Button x:Name="KeepAllButton" DockPanel.Dock="Right" Content="Keep the oldest of each" Click="KeepOldestAll"
                                Visibility="Collapsed" ToolTip="Moves every newer copy to the Recycle Bin" />
                        <TextBlock x:Name="DupeSummary" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>
                    <ItemsControl x:Name="DupeList" Template="{StaticResource Scroller}" ItemsPanel="{StaticResource Rows}"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,10,0">
                                    <!-- Group header -->
                                    <DockPanel Margin="0,12,0,4" Visibility="{Binding IsHeader, Converter={StaticResource Vis}}">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Keep oldest" Click="KeepOldest"
                                                ToolTip="Moves the newer copies to the Recycle Bin" />
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <!-- One copy -->
                                    <Grid Margin="12,1,0,1" Visibility="{Binding IsFile, Converter={StaticResource Vis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="70" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding File.Path}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding File.Path}" />
                                        <TextBlock Grid.Column="1" Text="{Binding When}" Style="{StaticResource Label}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Style="{StaticResource Act}" Content="&#xED25;" ToolTip="Show in Explorer" Click="ShowDupe" />
                                            <Button Style="{StaticResource Act}" Content="&#xE74D;" ToolTip="Move to the Recycle Bin" Click="RecycleDupe" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
