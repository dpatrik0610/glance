<UserControl x:Class="Glance.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Glance.Pages"
             xmlns:g="clr-namespace:Glance">
    <UserControl.Resources>
        <!-- A titled group of rows, hairlines between them (SettingRow draws its own top line) -->
        <Style x:Key="Group" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardFill}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardEdge}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="4,26,0,8" />
        </Style>
        <Style x:Key="Value" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="Width" Value="52" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>
        <Style TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
            <Setter Property="Width" Value="200" />
        </Style>
        <Style TargetType="local:SettingRow">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="local:SettingRow">
                        <Border BorderBrush="{StaticResource Line}" BorderThickness="{TemplateBinding BorderThickness}" Padding="18,12" MinHeight="66">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{TemplateBinding Icon}" FontFamily="{StaticResource Icons}" FontSize="17" Foreground="{StaticResource Sub}"
                                           VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,20,0">
                                    <TextBlock Text="{TemplateBinding Title}" FontSize="14" />
                                    <TextBlock x:Name="desc" Text="{TemplateBinding Description}" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                                <ContentPresenter Grid.Column="2" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Description" Value="{x:Null}">
                                <Setter TargetName="desc" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="6,0,6,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition MaxWidth="880" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <!-- About -->
                <Border Style="{StaticResource Group}" Padding="20,18">
                    <DockPanel>
                        <g:Logo x:Name="Mark" Width="48" Height="48" Margin="0,0,16,0" Pokeable="True" />
                        <Button x:Name="UpdateButton" DockPanel.Dock="Right" VerticalAlignment="Center" Content="Check for updates" Click="CheckUpdates" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Glance" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock x:Name="VersionText" Style="{StaticResource Label}" Margin="0,2,0,0" />
                            <TextBlock Foreground="{StaticResource Sub}" FontSize="12" Margin="0,4,0,0">
                                Made by dpatr ·
                                <Hyperlink NavigateUri="https://github.com/dpatrik0610" RequestNavigate="OpenLink" Foreground="{StaticResource Accent}">GitHub</Hyperlink> ·
                                <Hyperlink NavigateUri="https://dobospatrik.com" RequestNavigate="OpenLink" Foreground="{StaticResource Accent}">dobospatrik.com</Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <TextBlock Text="General" Style="{StaticResource Section}" />
                <Border Style="{StaticResource Group}">
                    <StackPanel>
                        <local:SettingRow x:Name="HotkeyRow" Icon="&#xE765;" Title="Show / hide shortcut">
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="HotkeyBox" Width="170" Tag="e.g. Win+Shift+G" KeyDown="HotkeyKey" />
                                <Button Content="Apply" Margin="8,0,0,0" Click="SetHotkey" />
                            </StackPanel>
                        </local:SettingRow>
                        <local:SettingRow x:Name="CaptureRow" Icon="&#xE70F;" Title="Quick capture shortcut">
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="CaptureBox" Width="170" Tag="e.g. Win+Shift+N (empty: off)" KeyDown="HotkeyKey" />
                                <Button Content="Apply" Margin="8,0,0,0" Click="SetHotkey" />
                            </StackPanel>
                        </local:SettingRow>
                        <local:SettingRow Icon="&#xE7E8;" Title="Start with Windows" Description="Opens in the tray when you sign in">
                            <CheckBox x:Name="AutoBox" Style="{StaticResource Switch}" Click="Toggled" />
                        </local:SettingRow>
                        <local:SettingRow Icon="&#xE8B7;" Title="Open CLI from Explorer" Description="Adds &quot;Open CLI&quot; to the folder right-click menu">
                            <CheckBox x:Name="MenuBox" Style="{StaticResource Switch}" Click="Toggled" />
                        </local:SettingRow>
                        <local:SettingRow Icon="&#xE72C;" Title="Refresh rate" Description="How often live stats update">
                            <StackPanel x:Name="RefreshRow" Orientation="Horizontal">
                                <Slider Minimum="250" Maximum="5000" IsSnapToTickEnabled="True" TickFrequency="250" />
                                <TextBlock Style="{StaticResource Value}" />
                            </StackPanel>
                        </local:SettingRow>
                    </StackPanel>
                </Border>

                <TextBlock Text="Appearance" Style="{StaticResource Section}" />
                <Border Style="{StaticResource Group}">
                    <StackPanel>
                        <local:SettingRow Icon="&#xE2B1;" Title="Theme" Description="Changing it restarts Glance">
                            <StackPanel x:Name="Themes" Orientation="Horizontal" />
                        </local:SettingRow>
                        <local:SettingRow Icon="&#xE790;" Title="Window opacity">
                            <StackPanel x:Name="OpacityRow" Orientation="Horizontal">
                                <Slider Minimum="0.1" Maximum="1" />
                                <TextBlock Style="{StaticResource Value}" />
                            </StackPanel>
                        </local:SettingRow>
                        <local:SettingRow Icon="&#xE793;" Title="Color glow" Description="Colored light on the glass">
                            <StackPanel x:Name="GlowRow" Orientation="Horizontal">
                                <Slider Minimum="0" Maximum="1" />
                                <TextBlock Style="{StaticResource Value}" />
                            </StackPanel>
                        </local:SettingRow>
                        <local:SettingRow Icon="&#xE771;" Title="Blur background" Description="Frosted glass behind the window">
                            <CheckBox x:Name="BlurBox" Style="{StaticResource Switch}" Click="Toggled" />
                        </local:SettingRow>
                        <local:SettingRow Icon="&#xE718;" Title="Always on top">
                            <CheckBox x:Name="TopBox" Style="{StaticResource Switch}" Click="Toggled" />
                        </local:SettingRow>
                        <local:SettingRow Icon="&#xE8A9;" Title="Compact mode" Description="Page tabs become icons along the top">
                            <CheckBox x:Name="CompactBox" Style="{StaticResource Switch}" Click="Toggled" />
                        </local:SettingRow>
                    </StackPanel>
                </Border>

                <TextBlock Text="Top bar" Style="{StaticResource Section}" />
                <Border Style="{StaticResource Group}">
                    <StackPanel>
                        <local:SettingRow Icon="&#xE7F4;" Title="Show the top bar"
                                          Description="Stays above other windows. Scroll or use the arrows to switch what it shows; click to open that page, the down arrow for a small panel.">
                            <CheckBox x:Name="BarBox" Style="{StaticResource Switch}" Click="Toggled" />
                        </local:SettingRow>
                        <local:SettingRow Icon="&#xE790;" Title="Opacity">
                            <StackPanel x:Name="BarOpacityRow" Orientation="Horizontal">
                                <Slider Minimum="0.1" Maximum="1" />
                                <TextBlock Style="{StaticResource Value}" />
                            </StackPanel>
                        </local:SettingRow>
                        <local:SettingRow Icon="&#xE799;" Title="Size">
                            <StackPanel x:Name="BarSizes" Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Chip}" GroupName="barsize" Content="Small" Margin="0,0,6,0" Checked="BarSizeChecked" />
                                <RadioButton Style="{StaticResource Chip}" GroupName="barsize" Content="Medium" Margin="0,0,6,0" Checked="BarSizeChecked" />
                                <RadioButton Style="{StaticResource Chip}" GroupName="barsize" Content="Large" Checked="BarSizeChecked" />
                            </StackPanel>
                        </local:SettingRow>
                        <local:SettingRow Icon="&#xE73F;" Title="Slim over maximized windows" Description="Shrinks to a thin line; hover it to show the bar">
                            <CheckBox x:Name="BarSlimBox" Style="{StaticResource Switch}" Click="Toggled" />
                        </local:SettingRow>
                        <local:SettingRow Icon="&#xE740;" Title="Hide during fullscreen apps">
                            <CheckBox x:Name="BarFullscreenBox" Style="{StaticResource Switch}" Click="Toggled" />
                        </local:SettingRow>
                    </StackPanel>
                </Border>

                <TextBlock Text="Alerts" Style="{StaticResource Section}" />
                <Border Style="{StaticResource Group}">
                    <StackPanel>
                        <local:SettingRow Icon="&#xEA8F;" Title="Hardware alerts" Description="Warns when a limit below is crossed and names the process behind it">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Test" Margin="0,0,14,0" Click="TestAlert" />
                                <CheckBox x:Name="AlertsBox" Style="{StaticResource Switch}" Click="Toggled" />
                            </StackPanel>
                        </local:SettingRow>
                        <local:SettingRow Icon="&#xE767;" Title="Play a sound" Description="For alerts and reminders">
                            <CheckBox x:Name="SoundBox" Style="{StaticResource Switch}" Click="Toggled" />
                        </local:SettingRow>
                        <!-- Picking a sound or letting go of the volume plays it -->
                        <local:SettingRow Icon="&#xEC4F;" Title="Sound">
                            <WrapPanel x:Name="Sounds" MaxWidth="360" HorizontalAlignment="Right" />
                        </local:SettingRow>
                        <local:SettingRow Icon="&#xE995;" Title="Volume">
                            <StackPanel x:Name="SoundVolumeRow" Orientation="Horizontal">
                                <Slider Minimum="0.05" Maximum="1" PreviewMouseLeftButtonUp="PreviewSound" />
                                <TextBlock Style="{StaticResource Value}" />
                            </StackPanel>
                        </local:SettingRow>
                        <local:SettingRow Icon="&#xE950;" Title="CPU temperature" Description="Alert at or above">
                            <StackPanel x:Name="CpuLimitRow" Orientation="Horizontal">
                                <Slider Minimum="50" Maximum="105" IsSnapToTickEnabled="True" TickFrequency="1" />
                                <TextBlock Style="{StaticResource Value}" />
                            </StackPanel>
                        </local:SettingRow>
                        <local:SettingRow Icon="&#xE7F8;" Title="GPU temperature" Description="Alert at or above">
                            <StackPanel x:Name="GpuLimitRow" Orientation="Horizontal">
                                <Slider Minimum="50" Maximum="105" IsSnapToTickEnabled="True" TickFrequency="1" />
                                <TextBlock Style="{StaticResource Value}" />
                            </StackPanel>
                        </local:SettingRow>
                        <local:SettingRow Icon="&#xE9D9;" Title="Memory usage" Description="Alert at or above">
                            <StackPanel x:Name="RamLimitRow" Orientation="Horizontal">
                                <Slider Minimum="50" Maximum="99" IsSnapToTickEnabled="True" TickFrequency="1" />
                                <TextBlock Style="{StaticResource Value}" />
                            </StackPanel>
                        </local:SettingRow>
                        <local:SettingRow Icon="&#xEDA2;" Title="Drive free space" Description="Alert at or below">
                            <StackPanel x:Name="DiskLimitRow" Orientation="Horizontal">
                                <Slider Minimum="1" Maximum="30" IsSnapToTickEnabled="True" TickFrequency="1" />
                                <TextBlock Style="{StaticResource Value}" />
                            </StackPanel>
                        </local:SettingRow>
                    </StackPanel>
                </Border>

                <TextBlock Text="Weather" Style="{StaticResource Section}" />
                <Border Style="{StaticResource Group}">
                    <StackPanel>
                        <local:SettingRow x:Name="CityRow" Icon="&#xE707;" Title="Hometown" Description="Where the Weather page forecasts">
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="CityBox" Width="200" Tag="City" KeyDown="CityKey" />
                                <Button Style="{StaticResource Primary}" Content="Set" Margin="8,0,0,0" Click="SetCity" />
                            </StackPanel>
                        </local:SettingRow>
                        <local:SettingRow Icon="&#xE9CA;" Title="Fahrenheit and mph">
                            <CheckBox x:Name="FBox" Style="{StaticResource Switch}" Click="Toggled" />
                        </local:SettingRow>
                    </StackPanel>
                </Border>

                <TextBlock Text="Money" Style="{StaticResource Section}" />
                <Border Style="{StaticResource Group}">
                    <local:SettingRow Icon="&#xE9D2;" Title="Stocks" Description="A watchlist on the Money page, with delayed quotes from Yahoo Finance">
                        <CheckBox x:Name="StocksBox" Style="{StaticResource Switch}" Click="Toggled" />
                    </local:SettingRow>
                </Border>

                <TextBlock Text="Media and clipboard" Style="{StaticResource Section}" />
                <Border Style="{StaticResource Group}">
                    <StackPanel>
                        <local:SettingRow Icon="&#xE8D6;" Title="Song change alerts" Description="Shows the new track when the song changes">
                            <CheckBox x:Name="TrackAlertsBox" Style="{StaticResource Switch}" Click="Toggled" />
                        </local:SettingRow>
                        <local:SettingRow Icon="&#xE77F;" Title="Clipboard history" Description="Kept in memory only, cleared when Glance exits">
                            <CheckBox x:Name="ClipBox" Style="{StaticResource Switch}" Click="Toggled" />
                        </local:SettingRow>
                        <local:SettingRow x:Name="ClipImagesRow" Icon="&#xEB9F;" Title="Include images" Description="The newest 20">
                            <CheckBox x:Name="ClipImagesBox" Style="{StaticResource Switch}" Click="Toggled" />
                        </local:SettingRow>
                    </StackPanel>
                </Border>

                <TextBlock Text="Logging" Style="{StaticResource Section}" />
                <Border Style="{StaticResource Group}">
                    <local:SettingRow Icon="&#xE8F1;" Title="MongoDB" Description="Logs and a metrics snapshot each minute go to the glance database, kept 30 days">
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="MongoBox" Width="260" Tag="mongodb://localhost:27017" />
                            <Button Content="Apply" Margin="8,0,0,0" Click="SetMongo" />
                        </StackPanel>
                    </local:SettingRow>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
