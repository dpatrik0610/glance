<UserControl x:Class="Glance.Pages.BillsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:g="clr-namespace:Glance">
    <UserControl.Resources>
        <Style x:Key="Act" TargetType="Button" BasedOn="{StaticResource Ghost}">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Foreground" Value="{StaticResource Sub}" />
        </Style>
        <Style x:Key="Field" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <DockPanel>
            <!-- Title row bar (IHeader) -->
            <StackPanel x:Name="Bar" DockPanel.Dock="Top" Orientation="Horizontal">
                <Button Style="{StaticResource Primary}" Content="New bill" Click="NewBill" />
            </StackPanel>
            <TextBlock x:Name="Count" DockPanel.Dock="Top" Style="{StaticResource Label}" />

            <Grid x:Name="Columns" DockPanel.Dock="Top" Margin="12,4,14,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.4*" />
                    <ColumnDefinition Width="1.3*" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="9" Height="1" VerticalAlignment="Bottom" Margin="-12,0,-14,-7" Background="{StaticResource Line}" />
                <TextBlock Text="Bill" Style="{StaticResource Label}" />
                <TextBlock Grid.Column="1" Text="Repeats" Style="{StaticResource Label}" />
                <TextBlock Grid.Column="2" Text="Next due" Style="{StaticResource Label}" />
                <TextBlock Grid.Column="3" Text="Amount" Style="{StaticResource Label}" HorizontalAlignment="Right" />
            </Grid>

            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="Rows">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- A bill: kind tile, name over kind, how often, a due pill, the amount; actions on hover -->
                                <Border x:Name="Row" Margin="0,0,10,0" Padding="12,10,4,10" Background="Transparent"
                                        BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" MouseLeftButtonUp="RowClick" Cursor="Hand">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2.4*" />
                                            <ColumnDefinition Width="1.3*" />
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="1.1*" />
                                            <ColumnDefinition Width="150" />
                                        </Grid.ColumnDefinitions>
                                        <DockPanel Margin="0,0,12,0">
                                            <Border Width="32" Height="32" CornerRadius="9" Background="{Binding KindBg}" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource Icons}" FontSize="15" Foreground="{Binding KindBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                <TextBlock Text="{Binding Kind}" Style="{StaticResource Label}" FontSize="12" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Repeats}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding PerMonth}" Style="{StaticResource Label}" FontSize="12" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="7" Padding="8,3,9,3"
                                                Background="{Binding DueBg}" ToolTip="{Binding DueDate}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="6" Height="6" Margin="0,1,6,0" VerticalAlignment="Center" Fill="{Binding DueBrush}" />
                                                <TextBlock Text="{Binding When}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding DueBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Grid.Column="3" Text="{Binding Amount}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Typography.NumeralAlignment="Tabular" />
                                        <StackPanel x:Name="Actions" Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" Opacity="0">
                                            <Button Style="{StaticResource Act}" Content="Paid" Foreground="{StaticResource Green}" Click="Paid"
                                                    ToolTip="Adds it to Budget as an expense and moves it to the next due date" />
                                            <Button Style="{StaticResource Act}" Content="&#xE70F;" FontFamily="{StaticResource Icons}" ToolTip="Edit" Click="Edit" />
                                            <Button Style="{StaticResource Act}" Content="&#xE74D;" FontFamily="{StaticResource Icons}" ToolTip="Delete" Click="Delete" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="{StaticResource CardBg}" />
                                        <Setter TargetName="Actions" Property="Opacity" Value="1" />
                                    </Trigger>
                                    <Trigger SourceName="Row" Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter TargetName="Actions" Property="Opacity" Value="1" />
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel x:Name="Empty" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380">
                    <g:Logo Width="44" Height="44" Margin="0,0,0,12" />
                    <TextBlock Text="No bills yet" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"
                               Text="Add rent, subscriptions, insurance or anything else that comes back. Glance reminds you the day before it's due." />
                    <Button Style="{StaticResource Primary}" Content="New bill" Margin="0,14,0,0" HorizontalAlignment="Center" Click="NewBill" />
                </StackPanel>
            </Grid>
        </DockPanel>

        <!-- The editor: a modal over the page -->
        <Grid x:Name="Editor" Background="#8C000000" Visibility="Collapsed" MouseLeftButtonDown="EditorBackdrop">
            <Border Style="{StaticResource Card}" Background="{StaticResource Popup}" Width="540" Padding="24,20" HorizontalAlignment="Center" VerticalAlignment="Center"
                    KeyDown="EditorKey">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="&#xE711;" FontFamily="{StaticResource Icons}" ToolTip="Close (Esc)" Click="CloseEditor" />
                        <TextBlock x:Name="EditorTitle" Text="New bill" Style="{StaticResource H}" FontSize="17" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="Name" Style="{StaticResource Field}" />
                    <TextBox x:Name="NameBox" Tag="Rent, Netflix, car insurance…" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Amount" Style="{StaticResource Field}" />
                            <TextBox x:Name="AmountBox" Tag="4500" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Next due" Style="{StaticResource Field}" />
                            <TextBox x:Name="DueBox" Tag="dec 5, 2026-12-05, fri" ToolTip="dec 5, 12.05, 2026-12-05, tomorrow, fri" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Repeats" Style="{StaticResource Field}" />
                    <Border Style="{StaticResource Segment}" HorizontalAlignment="Left">
                        <StackPanel x:Name="RepeatChips" Orientation="Horizontal" />
                    </Border>
                    <TextBlock Text="Kind" Style="{StaticResource Field}" />
                    <WrapPanel x:Name="KindChips" />
                    <CheckBox x:Name="RemindBox" Style="{StaticResource Switch}" Content="Remind me the day before" IsChecked="True" Margin="0,16,0,0" />
                    <TextBlock x:Name="EditorHint" Style="{StaticResource Label}" Foreground="{StaticResource Red}" Margin="0,12,0,0" Visibility="Collapsed" TextWrapping="Wrap" />
                    <DockPanel Margin="0,20,0,0">
                        <Button x:Name="DeleteButton" DockPanel.Dock="Left" Style="{StaticResource Ghost}" Content="Delete" Foreground="{StaticResource Red}" Click="DeleteEditing" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource Ghost}" Content="Cancel" Click="CloseEditor" Margin="0,0,8,0" />
                            <Button Style="{StaticResource Primary}" Content="Save" Click="Save" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Toast -->
        <Border x:Name="Toast" Background="{StaticResource Accent}" CornerRadius="14" Padding="14,6" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,8" Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock x:Name="ToastText" Foreground="{StaticResource OnAccent}" FontWeight="SemiBold" />
        </Border>
    </Grid>
</UserControl>
