<UserControl x:Class="Glance.Pages.DevPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <!-- Title row bar (IHeader): filter and refresh -->
        <StackPanel x:Name="Bar" DockPanel.Dock="Top" Orientation="Horizontal">
            <TextBox x:Name="Filter" Width="200" Tag="Filter by port or process" TextChanged="FilterChanged" />
            <Button Style="{StaticResource Ghost}" Content="&#xE72C;" FontFamily="{StaticResource Icons}" Margin="6,0,0,0" ToolTip="Refresh" Click="Refresh" />
        </StackPanel>
        <Grid DockPanel.Dock="Top" Margin="12,4,14,7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="70" />
            </Grid.ColumnDefinitions>
                <!-- Hairline under the column names -->
                <Border Grid.ColumnSpan="9" Height="1" VerticalAlignment="Bottom" Margin="-12,0,-14,-7" Background="{StaticResource Line}" />
            <TextBlock Text="Port" Style="{StaticResource Label}" />
            <TextBlock Grid.Column="1" Text="Process" Style="{StaticResource Label}" />
            <TextBlock Grid.Column="2" Text="PID" Style="{StaticResource Label}" />
            <TextBlock Grid.Column="3" Text="Address" Style="{StaticResource Label}" />
        </Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Ports">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Kill shows on hover -->
                        <Border x:Name="Row" Margin="0,0,10,0" Padding="12,10,4,10" Background="Transparent" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource Ghost}" HorizontalAlignment="Left" Padding="0,2" Click="OpenPort"
                                        ToolTip="Open http://localhost:port">
                                    <TextBlock Text="{Binding Port}" Foreground="{StaticResource Accent}" FontFamily="{StaticResource Mono}" />
                                </Button>
                                <TextBlock Grid.Column="1" Text="{Binding Process}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{Binding Pid}" Style="{StaticResource Label}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding Address}" Style="{StaticResource Label}" FontFamily="{StaticResource Mono}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Button x:Name="KillButton" Grid.Column="4" Style="{StaticResource Ghost}" Content="Kill" Foreground="{StaticResource Red}"
                                        HorizontalAlignment="Right" Opacity="0" Click="Kill" />
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource CardBg}" />
                                <Setter TargetName="KillButton" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger SourceName="Row" Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="KillButton" Property="Opacity" Value="1" />
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
