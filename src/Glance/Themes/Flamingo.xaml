<!-- Flamingo: soft flamingo to neon pinks (#FC94AF #FC8EAC #FF69B4 #FF6EC7 #FF1493) on a violet-to-sunset glass (#3B1C6E → #FF8A3D). Same keys as Mint.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="Text" Color="#FBEAF3" />
    <SolidColorBrush x:Key="Sub" Color="#C9A3C0" />
    <SolidColorBrush x:Key="CardBg" Color="#14FC94AF" />
    <SolidColorBrush x:Key="Line" Color="#24FC94AF" />
    <SolidColorBrush x:Key="Track" Color="#26FC94AF" />
    <SolidColorBrush x:Key="Accent" Color="#FF6EC7" />
    <SolidColorBrush x:Key="OnAccent" Color="#2B0620" />
    <SolidColorBrush x:Key="Green" Color="#4FE3C1" />
    <SolidColorBrush x:Key="Amber" Color="#FF8A3D" />
    <SolidColorBrush x:Key="Red" Color="#FF4D5E" />
    <SolidColorBrush x:Key="PillBg" Color="#26FF69B4" />

    <Color x:Key="PanelColor">#1A0B2E</Color>
    <Color x:Key="SurfaceColor">#24113A</Color>
    <SolidColorBrush x:Key="Popup" Color="#F524113A" />

    <Color x:Key="Glow1">#80E0167F</Color>
    <Color x:Key="Glow1Fade">#00E0167F</Color>
    <Color x:Key="Glow2">#B04A2390</Color>
    <Color x:Key="Glow2Fade">#004A2390</Color>
    <Color x:Key="Glow3">#66FF8A3D</Color>
    <Color x:Key="Glow3Fade">#00FF8A3D</Color>

    <!-- Thin horizon line along the window's top edge, and its glow. -->
    <LinearGradientBrush x:Key="TopLine" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FFB060" Offset="0" />
        <GradientStop Color="#FF4F9A" Offset="0.5" />
        <GradientStop Color="#9A5CFF" Offset="1" />
    </LinearGradientBrush>
    <Color x:Key="TopLineGlow">#FF4F9A</Color>

    <LinearGradientBrush x:Key="CardFill" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#26FF6EC7" Offset="0" />
        <GradientStop Color="#0FFC94AF" Offset="0.6" />
        <GradientStop Color="#18FF8A3D" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardEdge" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#80FF6EC7" Offset="0" />
        <GradientStop Color="#24FC94AF" Offset="0.3" />
        <GradientStop Color="#24FC94AF" Offset="0.7" />
        <GradientStop Color="#80FF8A3D" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardEdgeHot" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E0FF1493" Offset="0" />
        <GradientStop Color="#40FC94AF" Offset="0.4" />
        <GradientStop Color="#D0FF8A3D" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
