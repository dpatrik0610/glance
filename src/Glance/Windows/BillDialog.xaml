<Window x:Class="Glance.BillDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" Width="580" SizeToContent="Height"
        FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="{StaticResource Text}" TextOptions.TextFormattingMode="Display">
    <!-- The same glass as the event editor. 24px margin leaves room for the shadow. -->
    <Grid Margin="24">
        <Border CornerRadius="18" Background="{StaticResource Popup}" BorderBrush="{StaticResource Line}" BorderThickness="1" MouseLeftButtonDown="Drag">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.45" Color="Black" />
            </Border.Effect>
        </Border>
        <!-- Like the confirm dialog: the kind's colour as a glow from the top left and a lit edge -->
        <Border CornerRadius="18" BorderThickness="1" IsHitTestVisible="False">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop x:Name="EdgeStop" Offset="0" />
                    <GradientStop Color="#00FFFFFF" Offset="0.55" />
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.Background>
                <RadialGradientBrush Center="0,0" GradientOrigin="0,0" RadiusX="0.9" RadiusY="1.1">
                    <GradientStop x:Name="WashStop" Offset="0" />
                    <GradientStop Color="#00000000" Offset="1" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <StackPanel Margin="24,20,24,20">
            <StackPanel Orientation="Horizontal" IsHitTestVisible="False" Margin="0,0,0,14">
                <Ellipse x:Name="Dot" Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock x:Name="Label" FontSize="11" Foreground="{StaticResource Sub}" VerticalAlignment="Center" />
            </StackPanel>

            <!-- The name, big, with the kind's icon beside it -->
            <DockPanel Margin="0,0,0,14">
                <Border x:Name="Tile" DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="12" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TileIcon" FontFamily="{StaticResource Icons}" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBox x:Name="NameBox" Tag="Rent, Netflix, car insurance…" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="86" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Amount" Style="{StaticResource Label}" VerticalAlignment="Center" />
                <DockPanel Grid.Column="1" Margin="0,0,0,10">
                    <Button x:Name="CurrencyButton" DockPanel.Dock="Right" Style="{StaticResource Ghost}" Margin="8,0,0,0" Padding="10,6" Click="PickCurrency"
                            ToolTip="What it's charged in" />
                    <TextBox x:Name="AmountBox" Tag="4500" TextChanged="Changed" />
                </DockPanel>

                <TextBlock Grid.Row="1" Text="Kind" Style="{StaticResource Label}" Margin="0,8,0,0" />
                <WrapPanel x:Name="KindChips" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" />

                <TextBlock Grid.Row="2" Text="Repeats" Style="{StaticResource Label}" Margin="0,8,0,0" />
                <WrapPanel x:Name="RepeatChips" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" />

                <TextBlock Grid.Row="3" Text="Next due" Style="{StaticResource Label}" VerticalAlignment="Center" />
                <TextBox x:Name="DueBox" Grid.Row="3" Grid.Column="1" Tag="dec 5" TextChanged="Changed"
                         ToolTip="dec 5 · 12.05 · 2026-12-05 · tomorrow · fri" />
                <!-- How the date and the cost were read -->
                <TextBlock x:Name="ReadText" Grid.Row="4" Grid.Column="1" Style="{StaticResource Label}" FontSize="11.5" Margin="2,4,0,12" />

                <CheckBox x:Name="RemindBox" Grid.Row="5" Grid.Column="1" Style="{StaticResource Switch}" Content="Remind me the day before, at 9:00" IsChecked="True" />
            </Grid>

            <TextBlock x:Name="Error" Foreground="{StaticResource Red}" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed" />

            <DockPanel Margin="0,20,0,0">
                <Button x:Name="DeleteButton" DockPanel.Dock="Left" Style="{StaticResource Ghost}" Content="Delete" Foreground="{StaticResource Red}" Click="DeleteClick" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" IsCancel="True" Padding="18,8" Margin="0,0,8,0" />
                    <Button Style="{StaticResource Primary}" Content="Save" IsDefault="True" Padding="18,8" Click="SaveClick" />
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </Grid>
</Window>
