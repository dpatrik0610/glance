<Window x:Class="Glance.EventDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" Width="560" SizeToContent="Height"
        FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="{StaticResource Text}" TextOptions.TextFormattingMode="Display">
    <!-- Dialog's glass, with a form in it. 24px margin leaves room for the shadow. -->
    <Grid x:Name="Root" Margin="24">
        <Border CornerRadius="18" Background="{StaticResource Popup}" BorderBrush="{StaticResource Line}" BorderThickness="1" MouseLeftButtonDown="Drag">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.45" Color="Black" />
            </Border.Effect>
        </Border>

        <StackPanel Margin="24,20,24,20">
            <StackPanel Orientation="Horizontal" IsHitTestVisible="False" Margin="0,0,0,14">
                <Ellipse x:Name="Dot" Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,10,0" Fill="{StaticResource Accent}" />
                <TextBlock x:Name="Label" FontSize="11" Foreground="{StaticResource Sub}" VerticalAlignment="Center" />
            </StackPanel>

            <TextBox x:Name="TitleBox" Tag="Title" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="86" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Calendar" Style="{StaticResource Label}" Margin="0,8,0,0" />
                <WrapPanel x:Name="CalendarChips" Grid.Column="1" Margin="0,0,0,6" />

                <CheckBox x:Name="AllDayBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource Switch}" Content="All day" Margin="0,4,0,10"
                          Click="AllDayToggled" />

                <TextBlock Grid.Row="2" Text="Starts" Style="{StaticResource Label}" VerticalAlignment="Center" />
                <TextBox x:Name="StartBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" LostFocus="TimesChanged"
                         ToolTip="fri 10 · tomorrow 14:30 · 11.20 9:00 · 2026-12-24 18:00" />

                <TextBlock Grid.Row="3" Text="Ends" Style="{StaticResource Label}" VerticalAlignment="Center" />
                <TextBox x:Name="EndBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,4" LostFocus="TimesChanged"
                         ToolTip="11:00 (same day) · in 1h · in 90m · sat 18:00" />
                <TextBlock x:Name="WhenText" Grid.Row="4" Grid.Column="1" Style="{StaticResource Label}" FontSize="11.5" Margin="2,0,0,10" />

                <TextBlock Grid.Row="5" Text="Reminder" Style="{StaticResource Label}" Margin="0,8,0,0" />
                <WrapPanel x:Name="ReminderChips" Grid.Row="5" Grid.Column="1" Margin="0,0,0,6" />

                <TextBlock Grid.Row="6" Text="Where" Style="{StaticResource Label}" VerticalAlignment="Center" />
                <TextBox x:Name="WhereBox" Grid.Row="6" Grid.Column="1" Tag="Place or link" />
            </Grid>

            <TextBox x:Name="NotesBox" Tag="Notes" AcceptsReturn="True" TextWrapping="Wrap" Height="76" Margin="0,10,0,0"
                     VerticalScrollBarVisibility="Auto" />

            <TextBlock x:Name="Error" Foreground="{StaticResource Red}" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed" />

            <DockPanel Margin="0,18,0,0">
                <Button x:Name="DeleteButton" DockPanel.Dock="Left" Style="{StaticResource Ghost}" Content="Delete" Foreground="{StaticResource Red}"
                        Click="DeleteClick" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" IsCancel="True" Padding="18,8" Margin="0,0,8,0" Click="CancelClick" />
                    <Button x:Name="SaveButton" Style="{StaticResource Primary}" Content="Save" IsDefault="True" Padding="18,8" Click="SaveClick" />
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </Grid>
</Window>
