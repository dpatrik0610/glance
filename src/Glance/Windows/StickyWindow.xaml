<Window x:Class="Glance.StickyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:g="clr-namespace:Glance"
        Title="Sticky" WindowStyle="None" Background="Transparent" ResizeMode="CanResize" ShowInTaskbar="False" Topmost="True"
        MinWidth="200" MinHeight="130" FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="{StaticResource Text}"
        TextOptions.TextFormattingMode="Display">
    <!-- Same frame as the main window: glass over the whole client, so Windows rounds, shadows and blurs it. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="-1" ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <!-- Drag from any empty spot, like a paper note (buttons and text boxes keep their clicks) -->
    <Border x:Name="Tint" MouseLeftButtonDown="DragDown">
        <DockPanel Margin="10,6,10,10">
            <!-- Header: color and see-through in the dot's menu, ✕ takes it off the desktop -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <Button x:Name="DotButton" DockPanel.Dock="Left" Style="{StaticResource Ghost}" Padding="6" Click="DotClick" ToolTip="Color and see-through">
                    <Ellipse x:Name="Dot" Width="11" Height="11" />
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="✕" FontSize="11" ToolTip="Take off the desktop (it stays in Notes)"
                        Click="HideClick" />
                <!-- Only as wide as the title, so the rest of the header drags -->
                <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Tag="Title" FontWeight="SemiBold" FontSize="13"
                         HorizontalAlignment="Left" MinWidth="60"
                         Background="Transparent" BorderThickness="0" Padding="2,4" VerticalAlignment="Center" />
            </DockPanel>
            <g:NoteEditor x:Name="Editor" Compact="True" />
        </DockPanel>
    </Border>
</Window>
