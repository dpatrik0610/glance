<UserControl x:Class="Glance.NoteEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The body of a note (DataContext = Note): its text, or its checklist. Shared by the Notes page and
         the sticky windows; Compact trims it for a small window. -->
    <Grid>
        <TextBox x:Name="TextEditor" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Tag="Write something…"
                 AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" FontSize="{Binding FontSize}" FontFamily="{Binding Font}" Padding="14,12"
                 VerticalScrollBarVisibility="Auto" />

        <DockPanel x:Name="ChecklistEditor">
            <DockPanel x:Name="AddRow" DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <Button x:Name="ClearButton" DockPanel.Dock="Right" Content="Clear done" Margin="10,0,0,0" Click="ClearDone" />
                <TextBox x:Name="NewItem" Tag="Add an item and press Enter" KeyDown="NewItemKey" />
            </DockPanel>
            <TextBlock x:Name="Hint" DockPanel.Dock="Bottom" Style="{StaticResource Label}" FontSize="11" Margin="2,10,0,0"
                       Text="Due: tomorrow 9 · fri 14:00 · in 30m · 18:00 · 11.03 — then 🔔 to get a reminder" />
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,1,8,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Style="{StaticResource Check}" IsChecked="{Binding Done}" VerticalAlignment="Center" Margin="2,0,4,0" />
                                <TextBox x:Name="ItemText" Grid.Column="1" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent" BorderThickness="0" Padding="6,5" TextWrapping="Wrap"
                                         FontSize="{Binding DataContext.FontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         FontFamily="{Binding DataContext.Font, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                <!-- Compact (a sticky): the due time as plain text; it's set on the Notes page -->
                                <TextBlock x:Name="DueLabel" Grid.Column="2" Text="{Binding DueText}" Style="{StaticResource Label}" FontSize="11"
                                           VerticalAlignment="Center" Margin="6,0,2,0"
                                           Visibility="{Binding Brief, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                <TextBox x:Name="DueBox" Grid.Column="2" Text="{Binding DueText}" Tag="due…" Width="140"
                                         Visibility="{Binding Full, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         FontSize="12" Padding="10,4" Margin="6,0,0,0" VerticalAlignment="Center"
                                         ToolTip="tomorrow 9 · fri 14:00 · in 30m · 18:00 · 11.03 (Enter to set, empty to clear)"
                                         PreviewKeyDown="CommitOnEnter" />
                                <ToggleButton Grid.Column="3" Style="{StaticResource IconToggle}" Content="&#xEA8F;"
                                              IsChecked="{Binding Remind}" ToolTip="Remind me when it's due" Margin="2,0,0,0"
                                              Visibility="{Binding Full, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                <Button Grid.Column="4" Style="{StaticResource Ghost}" Content="✕" FontSize="11"
                                        ToolTip="Delete item" Click="DeleteItem" />
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Done}" Value="True">
                                    <Setter TargetName="ItemText" Property="Opacity" Value="0.4" />
                                    <Setter TargetName="DueBox" Property="Opacity" Value="0.4" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                    <Setter TargetName="DueBox" Property="Foreground" Value="{StaticResource Red}" />
                                    <Setter TargetName="DueLabel" Property="Foreground" Value="{StaticResource Red}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <!-- Font and size, opened from the pages' font button (ShowFontMenu) -->
        <Popup x:Name="FontMenu" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
            <Border Background="{StaticResource Popup}" CornerRadius="12" Padding="12" BorderBrush="{StaticResource Line}" BorderThickness="1" Width="260">
                <StackPanel>
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding FontSize}" Style="{StaticResource Label}" />
                        <TextBlock Text="Size (Ctrl+wheel)" Style="{StaticResource Label}" />
                    </DockPanel>
                    <Slider Minimum="9" Maximum="40" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding FontSize}" Margin="0,0,0,12" />
                    <TextBlock Text="Font" Style="{StaticResource Label}" Margin="0,0,0,4" />
                    <ListBox x:Name="FontList" Style="{StaticResource Sidebar}" Height="280" SelectedItem="{Binding Font}"
                             VirtualizingPanel.IsVirtualizing="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="{Binding}" FontSize="14" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
