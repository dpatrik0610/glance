<Window x:Class="Glance.BarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Glance"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Focusable="False" Title="Glance bar"
        FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="{StaticResource Text}" TextOptions.TextFormattingMode="Display"
        Typography.NumeralAlignment="Tabular" MouseWheel="Wheel">
    <Window.Resources>
        <!-- Small round glyph button: dim until hovered (chevrons; the music controls are brighter and larger) -->
        <Style x:Key="Arrow" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FontSize" Value="8" />
            <Setter Property="Foreground" Value="{StaticResource Sub}" /> 
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Width="20" Height="20" Background="Transparent">
                            <Ellipse x:Name="bg" Fill="White" Opacity="0" />
                            <TextBlock x:Name="glyph" Text="{TemplateBinding Content}" FontFamily="{StaticResource Icons}" FontSize="{TemplateBinding FontSize}"
                                       Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       RenderTransformOrigin="0.5,0.5" RenderTransform="{TemplateBinding Tag}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.1" />
                                <Setter TargetName="glyph" Property="Foreground" Value="{StaticResource Text}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.18" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

  <Grid>
    <!-- Slim mode (a maximized window under the bar): a thin line to hover. The zone around it catches the mouse. -->
    <Border x:Name="Sliver" Width="140" Height="9" Background="#01000000" VerticalAlignment="Top" Visibility="Collapsed"
            MouseEnter="SliverEnter" MouseLeave="SliverLeave">
        <Border x:Name="SliverLine" Width="72" Height="5" CornerRadius="2.5" Margin="0,2,0,0" VerticalAlignment="Top" BorderBrush="#40FFFFFF" BorderThickness="1" />
    </Border>
    <!-- Floating pill just below the top edge. Margin leaves room for the shadow. -->
    <Border x:Name="Pill" Margin="14,6,14,16" Height="32" CornerRadius="16" BorderBrush="#24FFFFFF" BorderThickness="1" Opacity="0">
        <Border.RenderTransform>
            <TranslateTransform x:Name="Slide" Y="-10" />
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.45" Color="Black" />
        </Border.Effect>
      <Grid>
        <!-- Song progress along the flat part of the bottom edge (Music view) -->
        <Grid x:Name="Progress" VerticalAlignment="Bottom" Height="2" Margin="16,0,16,2" IsHitTestVisible="False" Visibility="Collapsed">
            <Border Background="#1FFFFFFF" CornerRadius="1" />
            <Border Background="{StaticResource Accent}" CornerRadius="1" RenderTransformOrigin="0,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="Done" ScaleX="0" />
                </Border.RenderTransform>
            </Border>
        </Grid>
        <DockPanel Margin="5,0">
            <!-- The Glance icon: slides the menu open (Open Glance, then a button per view) -->
            <Button DockPanel.Dock="Left" Cursor="Hand" Focusable="False" ToolTip="Views · Open Glance" Click="GlanceClick" Margin="0,0,1,0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid Width="22" Height="22" Background="Transparent">
                            <Ellipse x:Name="bg" Fill="White" Opacity="0" />
                            <local:Logo Width="16" Height="16" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.18" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <!-- The normal face and the menu share one spot: opening the menu fades the face out and the icons in, while the
                 width glides from one to the other (ShowMenu) -->
            <Grid x:Name="Swap" ClipToBounds="True">
                <DockPanel x:Name="Normal">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Arrow}" Content="&#xE70D;" ToolTip="Details" Click="Down">
                        <Button.Tag>
                            <RotateTransform x:Name="Turn" />
                        </Button.Tag>
                    </Button>
                    <Border DockPanel.Dock="Right" Width="1" Height="11" Background="#24FFFFFF" Margin="3,0" />
                    <!-- Music controls (Music view only) -->
                    <StackPanel x:Name="Controls" DockPanel.Dock="Right" Orientation="Horizontal" Margin="2,0,4,0" Visibility="Collapsed">
                        <Button x:Name="PrevTrack" Style="{StaticResource Arrow}" FontSize="9" Foreground="{StaticResource Text}" Content="&#xE892;"
                                ToolTip="Previous song" Click="TrackPrev" />
                        <Button x:Name="PlayPause" Style="{StaticResource Arrow}" FontSize="10" Foreground="{StaticResource Text}" Click="TrackToggle" />
                        <Button x:Name="NextTrack" Style="{StaticResource Arrow}" FontSize="9" Foreground="{StaticResource Text}" Content="&#xE893;"
                                ToolTip="Next song" Click="TrackNext" />
                    </StackPanel>
                    <StackPanel x:Name="Body" Orientation="Horizontal" Margin="4,0" Background="Transparent" Cursor="Hand" ToolTip="Details"
                                MouseLeftButtonUp="BodyClick">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="Shift" />
                        </StackPanel.RenderTransform>
                        <TextBlock x:Name="Glyph" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{StaticResource Accent}"
                                   VerticalAlignment="Center" Margin="0,1,9,0" />
                        <Border x:Name="CoverBox" Width="16" Height="16" CornerRadius="4" Margin="0,0,8,0" VerticalAlignment="Center" Visibility="Collapsed">
                            <Border.Background>
                                <ImageBrush x:Name="CoverArt" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <StackPanel x:Name="Segs" Orientation="Horizontal" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                    </StackPanel>
                </DockPanel>
                <StackPanel x:Name="MenuRow" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Opacity="0" Visibility="Collapsed">
                    <StackPanel.RenderTransform>
                        <TranslateTransform x:Name="MenuShift" />
                    </StackPanel.RenderTransform>
                    <Button Style="{StaticResource Arrow}" FontSize="10" Foreground="{StaticResource Text}" Content="&#xE8A7;" ToolTip="Open Glance"
                            Click="OpenGlance" />
                    <Border Width="1" Height="11" Background="#24FFFFFF" Margin="3,0" />
                    <StackPanel x:Name="ViewButtons" Orientation="Horizontal" />
                    <Border Width="1" Height="11" Background="#24FFFFFF" Margin="3,0" />
                    <!-- Eyedropper: the picked color's hex goes straight to the clipboard -->
                    <Button x:Name="PickButton" Style="{StaticResource Arrow}" FontSize="10" Foreground="{StaticResource Text}" Content="&#xE790;"
                            ToolTip="Pick a color from screen (copies its hex)" Click="PickColor" Margin="0,0,2,0" />
                </StackPanel>
            </Grid>
        </DockPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
