<Window x:Class="Glance.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Glance"
        Title="Glance" Icon="Assets/Glance.ico" Width="1180" Height="760" MinWidth="820" MinHeight="560"
        WindowStyle="None" Background="Transparent" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="{StaticResource Text}"
        TextOptions.TextFormattingMode="Display">
    <!-- Not a layered window (no AllowsTransparency): glass frame over the whole client, so Windows 11 rounds,
         shadows and borders it natively, and native child windows can render. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="-1" ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Border x:Name="Panel" Background="Transparent">
      <Grid>
        <Grid x:Name="Glow" IsHitTestVisible="False">
            <Rectangle>
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.85,0" GradientOrigin="0.85,0" RadiusX="0.75" RadiusY="0.95">
                        <GradientStop Color="{StaticResource Glow1}" Offset="0" />
                        <GradientStop Color="{StaticResource Glow1Fade}" Offset="1" />
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle>
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0,0.6" GradientOrigin="0,0.6" RadiusX="0.6" RadiusY="0.8">
                        <GradientStop Color="{StaticResource Glow2}" Offset="0" />
                        <GradientStop Color="{StaticResource Glow2Fade}" Offset="1" />
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle>
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.35,1" GradientOrigin="0.35,1" RadiusX="0.5" RadiusY="0.45">
                        <GradientStop Color="{StaticResource Glow3}" Offset="0" />
                        <GradientStop Color="{StaticResource Glow3Fade}" Offset="1" />
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>
        <Grid x:Name="Body" Margin="14">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="BodyShift" />
            </Grid.RenderTransform>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <!-- Drag strip: the body's margin along the top edge -->
            <Border Grid.ColumnSpan="2" Height="14" VerticalAlignment="Top" Margin="-14,-14,-14,0" Background="Transparent" MouseLeftButtonDown="Drag" />

            <!-- Sidebar: a floating card. Brand, grouped tabs with live badges, the load card, Settings at the bottom.
                 Side clips; the hamburger animates its width to slide the pane in and out (ShowNav). -->
            <Grid x:Name="Side" ClipToBounds="True" HorizontalAlignment="Left">
            <Border x:Name="Pane" Margin="0,0,12,0" CornerRadius="14" HorizontalAlignment="Right"
                    Background="{StaticResource CardBg}" BorderBrush="{StaticResource Line}" BorderThickness="1">
            <Grid Width="220">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Background="Transparent" MouseLeftButtonDown="Drag" Margin="14,14,14,6">
                    <!-- The mark: glances when the window opens, flinches when poked -->
                    <local:Logo x:Name="Mark" Width="28" Height="28" Cursor="Hand" Pokeable="True" />
                    <Border DockPanel.Dock="Right" CornerRadius="6" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="6,1" VerticalAlignment="Center">
                        <TextBlock x:Name="VersionText" FontSize="11" Foreground="{StaticResource Sub}" />
                    </Border>
                    <TextBlock Text="Glance" FontSize="16" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                </DockPanel>
                <ListBox x:Name="Nav" Grid.Row="1" Margin="6,0" Style="{StaticResource Sidebar}" SelectionChanged="NavChanged" ContextMenuOpening="NavMenuOpening">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="HideItem" Click="HideTab" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <!-- Fold state comes from App.Settings.FoldedGroups (re-read when the view refreshes) -->
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="GroupItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="GroupItem">
                                                <StackPanel>
                                                    <ContentPresenter />
                                                    <ItemsPresenter x:Name="Items" />
                                                </StackPanel>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Name, Converter={x:Static local:MainWindow.Folded}}" Value="True">
                                                        <Setter TargetName="Items" Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                            <GroupStyle.HeaderTemplate>
                                <!-- Group name and a fold chevron (click to fold) -->
                                <DataTemplate>
                                    <Grid Margin="10,12,10,4" Background="Transparent" Cursor="Hand" MouseLeftButtonUp="GroupClick">
                                        <DockPanel>
                                            <TextBlock x:Name="Chevron" DockPanel.Dock="Right" Text="&#xE70D;" FontFamily="{StaticResource Icons}" FontSize="9"
                                                       Foreground="{StaticResource Sub}" VerticalAlignment="Center" Opacity="0.7" />
                                            <TextBlock Text="{Binding Name, Converter={x:Static local:MainWindow.Upper}}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Sub}" />
                                        </DockPanel>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Name, Converter={x:Static local:MainWindow.Folded}}" Value="True">
                                            <Setter TargetName="Chevron" Property="Text" Value="&#xE76C;" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel ToolTip="{Binding Name}">
                                <!-- Live value (CPU, download rate, running timer); empty for most pages -->
                                <TextBlock DockPanel.Dock="Right" DataContext="{Binding Name, Converter={x:Static local:MainWindow.BadgeOf}}"
                                           Text="{Binding Text}" Foreground="{Binding Brush}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource Icons}" FontSize="15" Width="20" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Name}" Margin="10,0,0,0" FontSize="13.5" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <!-- Load card: CPU now and its last minute, RAM; click for System -->
                <Border Grid.Row="2" Margin="10,8,10,0" Padding="14,10" CornerRadius="12" Cursor="Hand" ToolTip="Open System" MouseLeftButtonUp="LoadClick"
                        Background="{StaticResource CardBg}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock x:Name="LoadRam" DockPanel.Dock="Right" FontSize="12" Foreground="{StaticResource Sub}" />
                            <TextBlock Text="SYSTEM LOAD" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Sub}" />
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                            <TextBlock x:Name="LoadCpu" Text="—" FontSize="24" FontWeight="SemiBold" />
                            <TextBlock Text="% CPU" FontSize="12" Foreground="{StaticResource Sub}" VerticalAlignment="Bottom" Margin="4,0,0,5" />
                        </StackPanel>
                        <local:Spark x:Name="LoadSpark" Height="30" Max="100" Format="{}{0:0}%" />
                    </StackPanel>
                </Border>
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="6,6,6,2">
                    <ListBox x:Name="Bottom" Style="{StaticResource Sidebar}" SelectionChanged="NavChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <!-- Only Settings lives here -->
                                <local:Logo Icon="gear" Width="20" Height="20" ToolTip="{Binding Name}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <!-- Pages hidden from the sidebar (only shown when there are some) -->
                    <Button x:Name="MoreButton" Style="{StaticResource Ghost}" Content="&#xE712;" FontFamily="{StaticResource Icons}" FontSize="16"
                            Width="44" Height="40" Margin="4,0,0,4" VerticalAlignment="Top" ToolTip="Hidden pages" Click="MoreClick" Visibility="Collapsed" />
                </StackPanel>
            </Grid>
            </Border>
            </Grid>

            <!-- Main card: search and window buttons on top, the page header, the page below -->
            <Border Grid.Column="1" CornerRadius="14" Background="#1F000000" BorderBrush="{StaticResource Line}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <!-- Title row: search and window buttons (the CLI puts its shell tabs here, IHeader.OwnsTitleRow) -->
                    <Grid Background="Transparent" MouseLeftButtonDown="Drag" Margin="8,8,8,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="NavToggle" Style="{StaticResource Ghost}" Width="40" ToolTip="Hide sidebar" Click="ToggleNav">
                                <local:Logo Icon="menu" Width="17" Height="17" />
                            </Button>
                            <!-- Compact mode: the tabs as a row of icons instead of the sidebar -->
                            <ListBox x:Name="Strip" Style="{StaticResource Sidebar}" Visibility="Collapsed" Margin="2,0,0,0" SelectionChanged="StripChanged">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Icon}" ToolTip="{Binding Name}" FontFamily="{StaticResource Icons}" FontSize="15" Margin="-3,-3"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                        <ContentControl x:Name="TitleSlot" Grid.Column="1" Focusable="False" VerticalAlignment="Center" Margin="8,0,8,0" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <!-- Looks like a search box, opens the Ctrl+K palette -->
                            <Button Style="{StaticResource Ghost}" Padding="0" Margin="0,0,8,0" ToolTip="Search everything (Ctrl+K)" Click="PaletteClick"
                                    AutomationProperties.Name="Search">
                                <Border x:Name="SearchField" Width="300" Height="34" CornerRadius="9" Padding="12,0,6,0"
                                        Background="{StaticResource CardBg}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                                    <DockPanel>
                                        <local:Logo Icon="search" Width="14" Height="14" VerticalAlignment="Center" />
                                        <Border x:Name="SearchKey" DockPanel.Dock="Right" CornerRadius="4" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                                Padding="5,1" VerticalAlignment="Center">
                                            <TextBlock Text="Ctrl K" FontSize="11" Foreground="{StaticResource Sub}" />
                                        </Border>
                                        <TextBlock x:Name="SearchHint" Text="Search pages, notes, processes…" Margin="8,0,12,0" FontSize="13" Foreground="{StaticResource Sub}" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>
                            </Button>
                            <Button x:Name="PinButton" Style="{StaticResource Ghost}" FontFamily="{StaticResource Icons}" FontSize="13" Margin="0,0,4,0"
                                    Content="&#xE718;" Click="PinClick" />
                            <Button x:Name="CompactButton" Style="{StaticResource Ghost}" FontFamily="{StaticResource Icons}" FontSize="13" Margin="0,0,4,0"
                                    Content="&#xE73F;" ToolTip="Compact mode" Click="CompactClick" />
                            <Button Style="{StaticResource Ghost}" FontFamily="{StaticResource Icons}" FontSize="12" Margin="0,0,4,0"
                                    Content="&#xE921;" ToolTip="Minimize" Click="MinimizeClick" />
                            <Button x:Name="MaxButton" Style="{StaticResource Ghost}" FontFamily="{StaticResource Icons}" FontSize="12" Margin="0,0,4,0"
                                    Content="&#xE922;" ToolTip="Maximize" Click="MaximizeClick" />
                            <Button Style="{StaticResource Ghost}" ToolTip="Hide to tray (Esc)" Click="HideClick">
                                <local:Logo Icon="close" Width="17" Height="17" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Page header: the title over one line of state (IHeader.State), the page's controls on the right (IHeader.Header) -->
                    <DockPanel x:Name="PageHead" Grid.Row="1" Margin="24,8,24,16">
                        <ContentControl x:Name="HeaderSlot" DockPanel.Dock="Right" Focusable="False" VerticalAlignment="Bottom" Margin="16,0,0,0" />
                        <StackPanel VerticalAlignment="Bottom">
                            <TextBlock x:Name="PageTitle" FontSize="24" FontWeight="SemiBold" />
                            <ContentControl x:Name="StateSlot" Focusable="False" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <ContentControl x:Name="Page" Grid.Row="2" Margin="24,0,24,18" Focusable="False">
                        <ContentControl.RenderTransform>
                            <TranslateTransform x:Name="PageShift" />
                        </ContentControl.RenderTransform>
                    </ContentControl>
                </Grid>
            </Border>
        </Grid>

        <!-- Settings: a modal over the page, its sections listed on the left (Esc, the ×, or a click outside closes it) -->
        <Grid x:Name="SettingsLayer" Visibility="Collapsed" Background="#8C000000" MouseLeftButtonDown="SettingsBackdrop">
            <Border MaxWidth="1060" MaxHeight="800" Margin="40" CornerRadius="16" Padding="8" RenderTransformOrigin="0.5,0.5"
                    Background="{StaticResource Popup}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="SettingsZoom" />
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.6" />
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold" Margin="16,8,0,0" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Style="{StaticResource Ghost}" HorizontalAlignment="Right" ToolTip="Close (Esc)" Click="CloseSettingsClick">
                        <local:Logo Icon="close" Width="17" Height="17" />
                    </Button>
                    <ListBox x:Name="SettingsNav" Grid.Row="1" Margin="4,12,12,4" Style="{StaticResource Sidebar}" SelectionChanged="SettingsNavChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="13.5" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <ContentControl x:Name="SettingsHost" Grid.Row="1" Grid.Column="1" Focusable="False" />
                </Grid>
            </Border>
        </Grid>

        <!-- Ctrl+K command palette: one search over pages, actions, repos, containers, notes and clipboard -->
        <Grid x:Name="PaletteLayer" Visibility="Collapsed" Background="#8C000000" MouseLeftButtonDown="PaletteBackdrop">
            <Border x:Name="PaletteCard" Width="640" VerticalAlignment="Top" Margin="16,84,16,16" CornerRadius="20" Padding="10"
                    Background="{StaticResource Popup}" BorderBrush="{StaticResource Line}" BorderThickness="1" RenderTransformOrigin="0.5,0">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="PaletteZoom" />
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.6" />
                </Border.Effect>
                <DockPanel>
                    <!-- The TextBox applies its Padding twice (border + text host), so the box look lives on this Border instead -->
                    <Border DockPanel.Dock="Top" CornerRadius="14" Background="{StaticResource Track}" Padding="16,0,8,0">
                        <DockPanel>
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="15" Foreground="{StaticResource Accent}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox x:Name="Query" FontSize="16" Padding="2,11" Background="Transparent" BorderThickness="0"
                                     Tag="Search pages, repos, containers, notes, clipboard…" TextChanged="QueryChanged" PreviewKeyDown="QueryKey" />
                        </DockPanel>
                    </Border>
                    <DockPanel DockPanel.Dock="Bottom" Margin="8,8,8,2">
                        <TextBlock DockPanel.Dock="Right" Text="↑↓  ·  Enter  ·  Esc" Style="{StaticResource Label}" FontSize="11.5" Opacity="0.7" />
                        <TextBlock x:Name="PaletteStatus" Style="{StaticResource Label}" FontSize="11.5" Foreground="{StaticResource Accent}" />
                    </DockPanel>
                    <ListBox x:Name="Results" Style="{StaticResource Sidebar}" MaxHeight="430" Margin="0,8,0,0"
                             PreviewMouseLeftButtonUp="ResultClicked">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource Icons}" FontSize="15" Width="28" VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Kind}" FontSize="12" Opacity="0.65" Margin="12,0,0,0" VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                    <TextBlock Text="{Binding Title}" FontSize="13.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
        <!-- Horizon line along the top edge, above everything (like the Vice City Discord theme) -->
        <Rectangle Height="2" VerticalAlignment="Top" Fill="{StaticResource TopLine}" IsHitTestVisible="False">
            <Rectangle.Effect>
                <DropShadowEffect ShadowDepth="0" BlurRadius="10" Opacity="0.7" Color="{StaticResource TopLineGlow}" />
            </Rectangle.Effect>
        </Rectangle>
      </Grid>
    </Border>
</Window>
